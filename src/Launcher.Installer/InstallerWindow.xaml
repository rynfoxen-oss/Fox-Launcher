<Window x:Class="Launcher.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxLauncher Installer"
        Width="620" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="#FF151B24">

    <Window.Resources>
        <!-- ===== Palette ===== -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF1F2532"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF1E2633"/>
        <SolidColorBrush x:Key="CardAltBrush" Color="#FF232B3A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF2C3546"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFECEFF4"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA4B2"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6B7484"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFF8B3D"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFFFA468"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="StepActiveBrush" Color="#FFFF8B3D"/>
        <SolidColorBrush x:Key="StepDoneBrush" Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="StepPendingBrush" Color="#FF6B7484"/>

        <!-- ===== Buttons ===== -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerGhostBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground" Value="#FFE0524D"/>
            <Setter Property="BorderBrush" Value="#FFE0524D"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Texts ===== -->
        <Style x:Key="BigTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== Radio pill ===== -->
        <Style x:Key="InstallOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FF262033"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5A6476"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Checkbox pill ===== -->
        <Style x:Key="InstallCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FF262033"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5A6476"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF151B24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/fox.ico" Width="22" Height="22" Margin="16,0,0,0"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FoxLauncher Installer" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="v" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="v"/>
                        <Run x:Name="VersionRun" Text="1.0.3"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE8BB;"
                        Margin="0,0,8,0" Click="OnCloseClick"/>
            </Grid>

            <!-- ===== Step indicator ===== -->
            <Grid Grid.Row="1" Margin="36,20,36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Step1Indicator" Grid.Column="0" HorizontalAlignment="Center">
                    <Border x:Name="Step1Dot" Width="28" Height="28" CornerRadius="14"
                            Background="{StaticResource StepActiveBrush}" Margin="0,0,0,6">
                        <TextBlock Text="1" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Welcome" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step2Indicator" Grid.Column="1" HorizontalAlignment="Center">
                    <Border x:Name="Step2Dot" Width="28" Height="28" CornerRadius="14"
                            Background="{StaticResource StepPendingBrush}" Margin="0,0,0,6">
                        <TextBlock Text="2" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <TextBlock Text="License" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step3Indicator" Grid.Column="2" HorizontalAlignment="Center">
                    <Border x:Name="Step3Dot" Width="28" Height="28" CornerRadius="14"
                            Background="{StaticResource StepPendingBrush}" Margin="0,0,0,6">
                        <TextBlock Text="3" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Destination" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step4Indicator" Grid.Column="3" HorizontalAlignment="Center">
                    <Border x:Name="Step4Dot" Width="28" Height="28" CornerRadius="14"
                            Background="{StaticResource StepPendingBrush}" Margin="0,0,0,6">
                        <TextBlock Text="4" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Components" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step5Indicator" Grid.Column="4" HorizontalAlignment="Center">
                    <Border x:Name="Step5Dot" Width="28" Height="28" CornerRadius="14"
                            Background="{StaticResource StepPendingBrush}" Margin="0,0,0,6">
                        <TextBlock Text="5" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Install" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ===== Body (one panel per step) ===== -->
            <!-- ScrollViewer so a step taller than the window (e.g. a long
                 license agreement at high DPI) is never clipped at the bottom. -->
            <ScrollViewer Grid.Row="2" Margin="36,28,36,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel>
                <!-- Step 1 — Welcome -->
                <StackPanel x:Name="WelcomePanel">
                    <TextBlock Text="Welcome" Style="{StaticResource StepHeader}"/>
                    <TextBlock Text="Install FoxLauncher" Style="{StaticResource BigTitle}"/>
                    <TextBlock Text="A modern, open-source Minecraft launcher with mod browsing, world management, skins and more."
                               Style="{StaticResource SubText}" Margin="0,8,0,0"/>

                    <TextBlock Text="Install type" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,10"/>
                    <StackPanel>
                        <RadioButton x:Name="StandardRadio" Style="{StaticResource InstallOption}" IsChecked="True"
                                     GroupName="Mode">
                            <StackPanel>
                                <TextBlock Text="Standard install" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Installs for the current user and adds desktop &amp; Start menu shortcuts plus an Uninstall entry in Settings → Apps."
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="PortableRadio" Style="{StaticResource InstallOption}" Margin="0,10,0,0"
                                     GroupName="Mode" Checked="OnModeChanged" Unchecked="OnModeChanged">
                            <StackPanel>
                                <TextBlock Text="Portable install" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Runs from any folder without shortcuts or a registry entry. Easy to copy between machines."
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel x:Name="PortableRow" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Install folder" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <TextBox x:Name="PortablePathBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostBtn}"
                                    Margin="10,0,0,0" Click="OnBrowseClick"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Step 2 — License -->
                <StackPanel x:Name="LicensePanel" Visibility="Collapsed">
                    <TextBlock Text="Step 2 of 5" Style="{StaticResource StepHeader}"/>
                    <TextBlock Text="License agreement" Style="{StaticResource BigTitle}"/>
                    <TextBlock Text="Please read the following license agreement before installing FoxLauncher."
                               Style="{StaticResource SubText}" Margin="0,8,0,0"/>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Margin="0,16,0,0" Padding="14,12">
                        <ScrollViewer x:Name="LicenseScroll" Height="220" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnLicenseScrollChanged">
                            <TextBlock x:Name="LicenseText" Style="{StaticResource SubText}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="LicenseReadHint" Style="{StaticResource MutedText}"
                                   Text="Scroll to the end of the agreement to enable acceptance"/>
                        <TextBlock x:Name="LicenseReadDone" Style="{StaticResource MutedText}" Visibility="Collapsed"
                                   Foreground="{StaticResource SuccessBrush}">
                            <Run Text="&#xE73E;"/><Run Text="  You've reached the end of the agreement"/>
                        </TextBlock>
                    </Grid>

                    <CheckBox x:Name="AcceptLicenseCheck" Style="{StaticResource InstallCheck}" Margin="0,8,0,0"
                              IsEnabled="False" Checked="OnLicenseAcceptChanged" Unchecked="OnLicenseAcceptChanged">
                        <StackPanel>
                            <TextBlock Text="I accept the terms of this license agreement"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Required to install FoxLauncher."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- Step 3 — Destination -->
                <StackPanel x:Name="DestinationPanel" Visibility="Collapsed">
                    <TextBlock Text="Step 3 of 5" Style="{StaticResource StepHeader}"/>
                    <TextBlock Text="Choose install location" Style="{StaticResource BigTitle}"/>
                    <TextBlock Text="FoxLauncher will be installed into the folder below. You'll need about 200 MB of free space."
                               Style="{StaticResource SubText}" Margin="0,8,0,0"/>

                    <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="10"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Install folder" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="DestinationPathText" Text="" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostBtn}"
                                    Click="OnDestinationBrowseClick" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <CheckBox x:Name="PortableCheck" Style="{StaticResource InstallCheck}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Portable mode" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Don't add Start menu / desktop shortcuts or an Uninstall entry. Use this if you keep FoxLauncher on a USB stick."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- Step 4 — Components -->
                <StackPanel x:Name="ComponentsPanel" Visibility="Collapsed">
                    <TextBlock Text="Step 4 of 5" Style="{StaticResource StepHeader}"/>
                    <TextBlock Text="Choose components" Style="{StaticResource BigTitle}"/>
                    <TextBlock Text="Pick which features to install. You can change these later in Settings."
                               Style="{StaticResource SubText}" Margin="0,8,0,0"/>

                    <CheckBox x:Name="CoreCheck" Style="{StaticResource InstallCheck}" IsChecked="True" IsEnabled="False"
                              Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Core launcher files" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Required. The launcher executable and runtime."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="ModManagerCheck" Style="{StaticResource InstallCheck}" IsChecked="True"
                              Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Mod manager integration" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Browse, install and update mods from Modrinth, CurseForge and Forge."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="SkinPreviewCheck" Style="{StaticResource InstallCheck}" IsChecked="False"
                              Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="3-D skin preview" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Renders Minecraft skins in the Accounts page. Adds ~30 MB."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="DiscordCheck" Style="{StaticResource InstallCheck}" IsChecked="True"
                              Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Discord Rich Presence" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Show what you're playing on your Discord status. Can be disabled in Settings."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="LaunchWhenDoneCheck" Style="{StaticResource InstallCheck}" IsChecked="True"
                              Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Launch FoxLauncher when finished" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Open the launcher for you as soon as the install completes. Uncheck to stay on the Done screen."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- Step 5 — Progress -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock Text="Step 5 of 5" Style="{StaticResource StepHeader}"/>
                    <TextBlock Text="Installing FoxLauncher" Style="{StaticResource BigTitle}"/>
                    <TextBlock Text="Please wait while FoxLauncher is being installed on your computer."
                               Style="{StaticResource SubText}" Margin="0,8,0,0"/>

                    <StackPanel Margin="0,24,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="StepDownloadMark" Text="&#xE9F9;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Downloading launcher package"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="StepDownloadPct" Text=""
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="StepVerifyMark" Text="&#xE9F9;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Verifying checksums"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="StepVerifyPct" Text=""
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="StepExtractMark" Text="&#xE9F9;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Extracting files"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="StepExtractPct" Text=""
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="StepShortcutsMark" Text="&#xE9F9;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Creating shortcuts"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="StepShortcutsPct" Text=""
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <ProgressBar x:Name="OverallProgressBar" Height="8" Margin="0,16,0,0" Value="0" Maximum="100">
                        <ProgressBar.Foreground>
                            <SolidColorBrush Color="#FFFF8B3D"/>
                        </ProgressBar.Foreground>
                        <ProgressBar.Background>
                            <SolidColorBrush Color="#FF2A3345"/>
                        </ProgressBar.Background>
                    </ProgressBar>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstallSpinner" Grid.Column="0" Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                   Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="7" CenterY="7"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <TextBlock x:Name="ProgressStatusText" Grid.Column="1" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ProgressDetailText" Grid.Column="2" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" Text=""/>
                    </Grid>
                </StackPanel>

                <!-- Step 6 — Done -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed" Margin="0,40,0,0">
                    <Ellipse Width="72" Height="72" Fill="#1F4CAF50" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                             HorizontalAlignment="Center"/>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,-56,0,0"/>
                    <TextBlock Text="Installation complete" Style="{StaticResource BigTitle}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock x:Name="InstalledPathText" Style="{StaticResource SubText}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="FoxLauncher is ready to use. You can launch it now, or start it later from the Start menu."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Footer buttons ===== -->
            <Grid Grid.Row="3" Margin="36,8,36,24">
                <StackPanel x:Name="WelcomeFooter" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostBtn}" Click="OnCloseClick"/>
                    <Button x:Name="WelcomeNextBtn" Content="Next" Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0"
                            Click="OnNextClick"/>
                </StackPanel>

                <StackPanel x:Name="LicenseFooter" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Back" Style="{StaticResource GhostBtn}" Click="OnBackClick"/>
                    <Button Content="I Disagree" Style="{StaticResource DangerGhostBtn}" Margin="12,0,0,0"
                            Click="OnCloseClick"/>
                    <Button x:Name="LicenseAgreeBtn" Content="I Agree" Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0"
                            IsEnabled="False" Click="OnNextClick"/>
                </StackPanel>

                <StackPanel x:Name="DestinationFooter" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Back" Style="{StaticResource GhostBtn}" Click="OnBackClick"/>
                    <Button Content="Next" Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0"
                            Click="OnNextClick"/>
                </StackPanel>

                <StackPanel x:Name="ComponentsFooter" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Back" Style="{StaticResource GhostBtn}" Click="OnBackClick"/>
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0"
                            Click="OnInstallClick"/>
                </StackPanel>

                <StackPanel x:Name="ProgressFooter" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Hide" Style="{StaticResource GhostBtn}" Click="OnCloseClick"/>
                </StackPanel>

                <StackPanel x:Name="DoneFooter" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Uninstall later" Style="{StaticResource GhostBtn}" Click="OnUninstallLaterClick"
                            ToolTip="Open the graphical uninstaller so you can review and run it any time."/>
                    <Button Content="Close" Style="{StaticResource GhostBtn}" Margin="12,0,0,0" Click="OnCloseClick"/>
                    <Button Content="Launch FoxLauncher" Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0"
                            Click="OnLaunchClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
