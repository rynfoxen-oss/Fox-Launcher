<Window x:Class="Launcher.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxLauncher Installer"
        Width="580" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="#FF151B24">

    <Window.Resources>
        <!-- ===== Palette ===== -->
        <SolidColorBrush x:Key="HeaderBrush" Color="#FF1F2532"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF1E2633"/>
        <SolidColorBrush x:Key="CardAltBrush" Color="#FF232B3A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF2C3546"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFECEFF4"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA4B2"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6B7484"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFF8B3D"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFFFA468"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50"/>

        <!-- ===== Buttons ===== -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Texts ===== -->
        <Style x:Key="BigTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== Radio pill ===== -->
        <Style x:Key="InstallOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FF262033"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5A6476"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF151B24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/fox.ico" Width="22" Height="22" Margin="16,0,0,0"/>
                <TextBlock Grid.Column="1" Text="FoxLauncher Installer" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE8BB;"
                        Margin="0,0,8,0" Click="OnCloseClick"/>
            </Grid>

            <!-- ===== Body ===== -->
            <Grid Grid.Row="1" Margin="36,28,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Welcome -->
                <StackPanel x:Name="WelcomePanel">
                    <TextBlock Text="Install FoxLauncher" Style="{StaticResource BigTitle}"/>
                    <TextBlock Text="A modern, open-source Minecraft launcher with mod browsing, world management and more."
                               Style="{StaticResource SubText}" Margin="0,8,0,0"/>

                    <TextBlock Text="Install type" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,10"/>
                    <StackPanel>
                        <RadioButton x:Name="StandardRadio" Style="{StaticResource InstallOption}" IsChecked="True"
                                     GroupName="Mode">
                            <StackPanel>
                                <TextBlock Text="Standard install" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Installs for the current user and adds desktop &amp; Start menu shortcuts."
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="PortableRadio" Style="{StaticResource InstallOption}" Margin="0,10,0,0"
                                     GroupName="Mode" Checked="OnModeChanged" Unchecked="OnModeChanged">
                            <StackPanel>
                                <TextBlock Text="Portable install" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Runs from any folder without shortcuts or a registry entry."
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel x:Name="PortableRow" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Install folder" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <TextBox x:Name="PortablePathBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostBtn}"
                                    Margin="10,0,0,0" Click="OnBrowseClick"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Progress -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Installing FoxLauncher" Style="{StaticResource BigTitle}"/>
                    <TextBlock Text="Please wait while the launcher is being set up on your computer."
                               Style="{StaticResource SubText}" Margin="0,8,0,0"/>
                    <ProgressBar Height="8" IsIndeterminate="True" Margin="0,28,0,0">
                        <ProgressBar.Foreground>
                            <SolidColorBrush Color="#FFFF8B3D"/>
                        </ProgressBar.Foreground>
                        <ProgressBar.Background>
                            <SolidColorBrush Color="#FF2A3345"/>
                        </ProgressBar.Background>
                    </ProgressBar>
                    <TextBlock x:Name="ProgressStatusText" Style="{StaticResource MutedText}" Margin="0,16,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Done -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Ellipse Width="72" Height="72" Fill="#1F4CAF50" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                             HorizontalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,-56,0,0"/>
                    <TextBlock Text="Installation complete" Style="{StaticResource BigTitle}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock x:Name="InstalledPathText" Style="{StaticResource SubText}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="FoxLauncher is ready to use. You can launch it now, or start it later from the Start menu."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- ===== Footer buttons ===== -->
                <StackPanel x:Name="WelcomeButtons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostBtn}" Click="OnCloseClick"/>
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0"
                            Click="OnInstallClick"/>
                </StackPanel>

                <StackPanel x:Name="DoneButtons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,20,0,0" Visibility="Collapsed">
                    <Button Content="Close" Style="{StaticResource GhostBtn}" Click="OnCloseClick"/>
                    <Button Content="Launch FoxLauncher" Style="{StaticResource PrimaryBtn}" Margin="12,0,0,0"
                            Click="OnLaunchClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
