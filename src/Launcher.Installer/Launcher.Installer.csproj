<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Launcher.Installer</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Utils\Launcher.Utils.csproj" />
  </ItemGroup>

  <!-- The single-file published launcher is embedded as a resource by build.ps1 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\artifacts\publish\FoxLauncher.exe"
                      Link="Resources\FoxLauncher.exe"
                      Condition="Exists('..\..\artifacts\publish\FoxLauncher.exe')" />
  </ItemGroup>

</Project>
