using Launcher.Downloads;
using Launcher.Models;
using Launcher.Network;
using Launcher.Services;
using Launcher.Utils;
using System.IO.Compression;

namespace Launcher.ModManager;

/// <summary>
/// Installs, enables, disables and removes mods for an instance. Mods are
/// stored in the instance's <c>.minecraft/mods</c> folder; disabling uses the
/// classic leading-dot convention.
/// </summary>
public sealed class ModManagerService
{
    private readonly LogService _log;
    private readonly DownloadManager _downloads;
    private readonly ModrinthApi _modrinth;
    private readonly ModMetadataService _metadata;

    public ModManagerService(LogService log, DownloadManager downloads, ModrinthApi modrinth, ModMetadataService metadata)
    {
        _log = log;
        _downloads = downloads;
        _modrinth = modrinth;
        _metadata = metadata;
    }

    /// <summary>Lists installed mods for an instance, enriched with metadata.</summary>
    public List<ModInfo> ListMods(string instanceId)
    {
        var dir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
        if (!Directory.Exists(dir)) return new List<ModInfo>();

        return Directory.GetFiles(dir, "*.jar")
            .OrderBy(f => Path.GetFileName(f).StartsWith("."))
            .Select(path =>
            {
                var mod = _metadata.GetMetadata(path);
                
                // Merge with stored Modrinth metadata if available
                var clean = mod.Enabled ? mod.FileName : mod.FileName[1..];
                var meta = Json.ReadFromFile<ModMetadata>(MetadataPath(instanceId, clean));
                if (meta != null)
                {
                    mod.ProjectId = meta.ProjectId;
                    mod.VersionId = meta.VersionId;
                    mod.Title ??= meta.Title;
                    mod.Description ??= meta.Description;
                    mod.IconUrl ??= meta.IconUrl;
                    mod.Version ??= meta.VersionNumber;
                    mod.InstalledAt = meta.InstalledAt;
                }

                return mod;
            })
            .ToList();
    }

    /// <summary>Returns the Modrinth project ids currently installed in an instance.</summary>
    public HashSet<string> InstalledProjectIds(string instanceId)
        => ListMods(instanceId)
            .Where(m => !string.IsNullOrEmpty(m.ProjectId))
            .Select(m => m.ProjectId!)
            .ToHashSet();

    /// <summary>Persists Modrinth metadata for an installed mod so it survives restarts.</summary>
    private static void WriteMetadata(string instanceId, ModInfo mod)
    {
        if (string.IsNullOrEmpty(mod.ProjectId)) return;
        var meta = new ModMetadata
        {
            ProjectId = mod.ProjectId,
            VersionId = mod.VersionId ?? "",
            VersionNumber = mod.Version ?? "",
            Title = mod.Title ?? mod.FileName,
            Description = mod.Description ?? "",
            IconUrl = mod.IconUrl ?? "",
            InstalledAt = mod.InstalledAt
        };
        Json.WriteToFile(MetadataPath(instanceId, mod.FileName), meta);
    }

    private static string MetadataPath(string instanceId, string cleanFileName)
        => Path.Combine(Paths.InstanceMinecraft(instanceId), "mods", $"{cleanFileName}.json");

    /// <summary>Stored Modrinth metadata for an installed mod jar.</summary>
    private sealed class ModMetadata
    {
        public string ProjectId { get; set; } = "";
        public string VersionId { get; set; } = "";
        public string VersionNumber { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string IconUrl { get; set; } = "";
        public DateTimeOffset InstalledAt { get; set; } = DateTimeOffset.UtcNow;
    }

    /// <summary>Installs a local mod jar into an instance.</summary>
    public bool InstallLocal(string instanceId, string jarPath)
    {
        if (!File.Exists(jarPath) || !jarPath.EndsWith(".jar", StringComparison.OrdinalIgnoreCase)) return false;
        var target = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods", Path.GetFileName(jarPath));
        if (!Directory.Exists(Path.GetDirectoryName(target)!)) Directory.CreateDirectory(Path.GetDirectoryName(target)!);
        File.Copy(jarPath, target, overwrite: true);
        _log.Info($"Installed local mod '{Path.GetFileName(jarPath)}' into '{instanceId}'");
        return true;
    }

    /// <summary>
    /// Installs a mod from Modrinth (with automatic required dependencies) for
    /// an instance using its loader and game version.
    /// </summary>
    public async Task<(ModInfo Mod, List<ModInfo> Dependencies)> InstallFromModrinthAsync(
        string instanceId, string projectId, ModLoaderType loader, string gameVersion, CancellationToken ct = default)
    {
        var versions = await _modrinth.GetVersionsAsync(projectId, loader, gameVersion, ct);
        var version = versions.FirstOrDefault()
            ?? throw new InvalidOperationException($"No {loader} version of this mod supports Minecraft {gameVersion}.");

        var file = version.Files.FirstOrDefault()
            ?? throw new InvalidOperationException("This mod version has no downloadable file.");

        var modDir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
        Directory.CreateDirectory(modDir);

        var target = Path.Combine(modDir, file.Filename);
        var result = await _downloads.DownloadFileAsync(new DownloadItem
        {
            Url = file.Url,
            DestinationPath = target,
            Size = file.Size,
            Sha1 = file.Hashes.TryGetValue("sha1", out var sha1) ? sha1 : null,
            Sha256 = file.Hashes.TryGetValue("sha512", out var sha512) ? sha512 : null,
            Label = file.Filename
        }, ct: ct);

        if (!result.Success)
            throw new InvalidOperationException($"Failed to download '{file.Filename}': {result.ErrorMessage}");

        var project = await _modrinth.GetProjectAsync(projectId, ct);
        var mod = new ModInfo
        {
            FileName = file.Filename,
            ProjectId = projectId,
            VersionId = version.Id,
            Title = project.Title,
            Description = project.Description,
            Authors = string.IsNullOrEmpty(project.Slug) ? new List<string>() : new List<string> { project.Slug! },
            IconUrl = project.IconUrl,
            Version = version.VersionNumber,
            Enabled = true,
            Size = file.Size,
            InstalledAt = DateTimeOffset.UtcNow
        };
        WriteMetadata(instanceId, mod);

        var dependencies = new List<ModInfo>();
        foreach (var dep in version.Dependencies.Where(d =>
                     d.DependencyType == "required" && !string.IsNullOrEmpty(d.ProjectId)))
        {
            try
            {
                var (depMod, depDeps) = await InstallFromModrinthAsync(instanceId, dep.ProjectId!, loader, gameVersion, ct);
                dependencies.Add(depMod);
                dependencies.AddRange(depDeps);
            }
            catch (Exception ex)
            {
                _log.Warn($"Skipped dependency '{dep.ProjectId}': {ex.Message}");
            }
        }

        _log.Info($"Installed mod '{file.Filename}' into '{instanceId}'");
        return (mod, dependencies);
    }

    /// <summary>Enables or disables a mod by renaming the jar file.</summary>
    public bool ToggleMod(string instanceId, ModInfo mod)
    {
        var dir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
        var enabledPath = Path.Combine(dir, mod.FileName);
        var disabledPath = Path.Combine(dir, $".{mod.FileName}");

        if (mod.Enabled)
        {
            if (File.Exists(enabledPath)) File.Move(enabledPath, disabledPath);
            mod.Enabled = false;
        }
        else
        {
            if (File.Exists(disabledPath)) File.Move(disabledPath, enabledPath);
            mod.Enabled = true;
        }
        return mod.Enabled;
    }

    /// <summary>Deletes a mod file (and its stored metadata) from an instance.</summary>
    public bool DeleteMod(string instanceId, ModInfo mod)
    {
        var dir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
        var enabled = Path.Combine(dir, mod.FileName);
        var disabled = Path.Combine(dir, $".{mod.FileName}");
        var metaPath = MetadataPath(instanceId, mod.FileName);
        var deleted = false;
        if (File.Exists(enabled)) { File.Delete(enabled); deleted = true; }
        if (File.Exists(disabled)) { File.Delete(disabled); deleted = true; }
        if (File.Exists(metaPath)) { File.Delete(metaPath); }
        if (deleted) _log.Info($"Deleted mod '{mod.FileName}' from '{instanceId}'");
        return deleted;
    }

    /// <summary>Installs a mod from Modrinth (with automatic required dependencies) for
    /// an instance using its loader and game version.</summary>
                var (depMod, depDeps) = await InstallFromModrinthAsync(instanceId, dep.ProjectId!, loader, gameVersion, ct);
                dependencies.Add(depMod);
                dependencies.AddRange(depDeps);
            }
            catch (Exception ex)
            {
                _log.Warn($"Skipped dependency '{dep.ProjectId}': {ex.Message}");
            }
        }

        _log.Info($"Installed mod '{file.Filename}' into '{instanceId}'");
        return (mod, dependencies);
    }

    /// <summary>Toggles enabled state for multiple mods at once.</summary>
    public void BatchToggle(string instanceId, List<ModInfo> mods, bool enable)
    {
        foreach (var mod in mods)
        {
            mod.Enabled = enable;
            ToggleMod(instanceId, mod);
        }
    }

    /// <summary>Deletes multiple mods at once.</summary>
    public int BatchDelete(string instanceId, List<ModInfo> mods)
    {
        var count = 0;
        foreach (var mod in mods)
        {
            if (DeleteMod(instanceId, mod)) count++;
        }
        return count;
    }

    /// <summary>Updates a single mod to its latest version.</summary>
    public async Task<(bool Success, string Message)> UpdateModAsync(
        string instanceId, ModInfo mod, ModLoaderType loader, string gameVersion, CancellationToken ct = default)
    {
        if (string.IsNullOrEmpty(mod.ProjectId) || string.IsNullOrEmpty(mod.LatestVersionId))
            return (false, "No update available or project ID missing.");

        try
        {
            var versions = await _modrinth.GetVersionsAsync(mod.ProjectId, loader, gameVersion, ct);
            var target = versions.FirstOrDefault(v => v.Id == mod.LatestVersionId);
            if (target == null) return (false, "Latest version not found for this loader/game combo.");

            var file = target.Files.FirstOrDefault();
            if (file == null) return (false, "No downloadable file for this version.");

            var modDir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
            var targetPath = Path.Combine(modDir, file.Filename);

            // Backup current file before updating
            var backupPath = Path.Combine(modDir, $"{Path.GetFileNameWithoutExtension(mod.FileName)}.backup.{DateTimeOffset.UtcNow:yyyyMMddHHmmss}.jar");
            if (File.Exists(Path.Combine(modDir, mod.DiskName)))
                File.Copy(Path.Combine(modDir, mod.DiskName), backupPath, overwrite: true);

            var result = await _downloads.DownloadFileAsync(new DownloadItem
            {
                Url = file.Url,
                DestinationPath = targetPath,
                Size = file.Size,
                Sha1 = file.Hashes.TryGetValue("sha1", out var sha1) ? sha1 : null,
                Sha256 = file.Hashes.TryGetValue("sha512", out var sha512) ? sha512 : null,
                Label = file.Filename
            }, ct: ct);

            if (!result.Success) return (false, $"Download failed: {result.ErrorMessage}");

            // Remove old file (both enabled and disabled variants)
            var oldEnabled = Path.Combine(modDir, mod.FileName);
            var oldDisabled = Path.Combine(modDir, $".{mod.FileName}");
            if (File.Exists(oldEnabled)) File.Delete(oldEnabled);
            if (File.Exists(oldDisabled)) File.Delete(oldDisabled);

            mod.FileName = file.Filename;
            mod.VersionId = target.Id;
            mod.Version = target.VersionNumber;
            mod.Size = file.Size;
            mod.HasUpdate = false;
            mod.LatestVersionNumber = null;
            WriteMetadata(instanceId, mod);

            _log.Info($"Updated mod '{mod.Title ?? mod.FileName}' to {target.VersionNumber}");
            return (true, $"Updated to {target.VersionNumber}.");
        }
        catch (Exception ex)
        {
            return (false, ex.Message);
        }
    }

    /// <summary>Updates all mods that have available updates.</summary>
    public async Task<(int Updated, int Failed, int Skipped)> UpdateAllModsAsync(
        string instanceId, ModLoaderType loader, string gameVersion, CancellationToken ct = default)
    {
        var mods = ListMods(instanceId).Where(m => m.HasUpdate && !string.IsNullOrEmpty(m.ProjectId)).ToList();
        int updated = 0, failed = 0, skipped = 0;

        foreach (var mod in mods)
        {
            var (success, msg) = await UpdateModAsync(instanceId, mod, loader, gameVersion, ct);
            if (success) updated++;
            else if (msg.Contains("not found") || msg.Contains("missing")) skipped++;
            else failed++;
        }

        return (updated, failed, skipped);
    }

    /// <summary>Rolls back a mod to its previous version using the backup file.</summary>
    public bool RollbackMod(string instanceId, ModInfo mod)
    {
        var modDir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
        var backupFiles = Directory.GetFiles(modDir, $"{Path.GetFileNameWithoutExtension(mod.FileName)}.backup.*.jar")
            .OrderByDescending(f => f)
            .ToList();

        if (backupFiles.Count == 0) return false;

        var latestBackup = backupFiles[0];
        var targetPath = Path.Combine(modDir, mod.DiskName);
        File.Copy(latestBackup, targetPath, overwrite: true);
        _log.Info($"Rolled back mod '{mod.Title ?? mod.FileName}' from backup.");
        return true;
    }

    /// <summary>Imports mods from a ZIP archive into an instance.</summary>
    public void ImportFromZip(string instanceId, string zipPath)
    {
        var modDir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
        Directory.CreateDirectory(modDir);

        using var archive = ZipFile.OpenRead(zipPath);
        foreach (var entry in archive.Entries)
        {
            if (entry.FullName.EndsWith(".jar", StringComparison.OrdinalIgnoreCase))
            {
                var destination = Path.Combine(modDir, entry.Name);
                entry.ExtractToFile(destination, overwrite: true);
            }
        }
        _log.Info($"Imported mods from ZIP into '{instanceId}'");
    }

    /// <summary>Imports mods from a folder into an instance.</summary>
    public int ImportFromFolder(string instanceId, string folderPath)
    {
        var modDir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
        Directory.CreateDirectory(modDir);

        var jarFiles = Directory.GetFiles(folderPath, "*.jar", SearchOption.TopDirectoryOnly);
        int count = 0;
        foreach (var jar in jarFiles)
        {
            var dest = Path.Combine(modDir, Path.GetFileName(jar));
            File.Copy(jar, dest, overwrite: true);
            count++;
        }
        _log.Info($"Imported {count} mod(s) from folder into '{instanceId}'");
        return count;
    }

    /// <summary>Exports all mods from an instance as a ZIP archive.</summary>
    public void ExportAsZip(string instanceId, string destinationPath)
    {
        var modsDir = Path.Combine(Paths.InstanceMinecraft(instanceId), "mods");
        if (!Directory.Exists(modsDir)) return;

        if (File.Exists(destinationPath)) File.Delete(destinationPath);
        ZipFile.CreateFromDirectory(modsDir, destinationPath);
    }

    /// <summary>Exports the mod list as a shareable JSON manifest.</summary>
    public void ExportManifest(string instanceId, string destinationPath)
    {
        var mods = ListMods(instanceId);
        var manifest = new
        {
            InstanceId = instanceId,
            ExportedAt = DateTimeOffset.UtcNow,
            Mods = mods.Select(m => new
            {
                m.Title,
                m.FileName,
                m.ProjectId,
                m.VersionId,
                m.Version
            }).ToList()
        };

        var json = System.Text.Json.JsonSerializer.Serialize(manifest, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        File.WriteAllText(destinationPath, json);
    }

    /// <summary>Opens the instance's mods folder in Explorer.</summary>
    public void OpenModsFolder(string instanceId)
        => ProcessHelper.Open(Path.Combine(Paths.InstanceMinecraft(instanceId), "mods"));
}
