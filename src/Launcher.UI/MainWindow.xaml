<Window x:Class="Launcher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Launcher.ViewModels;assembly=Launcher.ViewModels"
        xmlns:ctl="clr-namespace:Launcher.Views.Controls;assembly=Launcher.Views"
        xmlns:pages="clr-namespace:Launcher.Views.Pages;assembly=Launcher.Views"
        xmlns:conv="clr-namespace:Launcher.Views.Converters;assembly=Launcher.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FoxLauncher"
        Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        WindowStyle="None" ResizeMode="CanResize">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <pages:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
            <pages:InstancesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <pages:ModsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResourcePacksViewModel}">
            <pages:ResourcePacksPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShadersViewModel}">
            <pages:ShadersPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorldsViewModel}">
            <pages:WorldsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}">
            <pages:ServersPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScreenshotsViewModel}">
            <pages:ScreenshotsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewsViewModel}">
            <pages:NewsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <pages:LogsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <pages:AccountsPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackground}" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/assets/icons/fox.ico" Width="18" Height="18"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="FoxLauncher" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Text="{Binding AppVersion, FallbackValue='v1.1.9'}" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="40,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimizeClick"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE922;" ToolTip="Maximize" Click="OnMaximizeClick"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="0" MaxWidth="300"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="{DynamicResource TitleBarBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource GhostButton}" Margin="12,12,12,8" Padding="10,8"
                        Command="{Binding ToggleSidebarCommand}" ToolTip="Collapse sidebar">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        <TextBlock Text="  Navigation" Style="{StaticResource SectionTitleText}"/>
                    </StackPanel>
                </Button>

                <!-- Instance selector -->
                <Border Grid.Row="1" Margin="12,0,12,10" Padding="10"
                        Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Selected instance" Style="{StaticResource CaptionText}"/>
                        <ComboBox ItemsSource="{Binding Instances}" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedInstanceId, Mode=TwoWay}"
                                  Style="{StaticResource InputComboBox}" Margin="0,6,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ListBox x:Name="NavList" Grid.Row="2" ItemsSource="{Binding Pages}"
                         Style="{StaticResource NavListBox}" Margin="12,0,12,8"
                         SelectionChanged="OnNavSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="10,7">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Account -->
                <Button Grid.Row="3" Margin="12,0,12,10" Style="{StaticResource GhostButton}" Padding="10"
                        HorizontalContentAlignment="Stretch" Command="{Binding NavigateAccountsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ctl:AvatarImage Width="32" Height="32" ImageUrl="{Binding ActiveAccount.AvatarUrl}"
                                         DisplayName="{Binding ActiveAccount.Username}"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveAccount.Username, FallbackValue='Not signed in'}"
                                       Style="{StaticResource BaseText}"/>
                            <TextBlock Text="{Binding ActiveAccount.Type, FallbackValue='No account'}"
                                       Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

            <!-- Content -->
            <Grid Grid.Column="2" Background="{DynamicResource WindowBackground}">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="18" Margin="18"
                        Effect="{DynamicResource CardShadow}">
                    <ContentControl Content="{Binding CurrentPage}"/>
                </Border>
                <Button Style="{StaticResource IconButton}" Content="&#xE700;" Command="{Binding ToggleSidebarCommand}"
                        ToolTip="Expand sidebar" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8" Padding="10,8" Background="{DynamicResource TitleBarBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="14,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="View crash report"
                        VerticalAlignment="Center"
                        Command="{Binding OpenCrashReportCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Margin" Value="0,5,10,5"/>
                            <Setter Property="Padding" Value="10,2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCrashReport}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding SelectedInstance.Name, StringFormat='Instance: {0}'}"
                           Style="{StaticResource CaptionText}" Margin="0,0,14,0" VerticalAlignment="Center"
                           Visibility="{Binding SelectedInstance, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>
                <TextBlock Grid.Column="3" Text="Playing"
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                           Margin="0,0,14,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
