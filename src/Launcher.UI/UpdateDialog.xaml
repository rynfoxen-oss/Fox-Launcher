<Window x:Class="Launcher.UI.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxLauncher — Updating"
        Width="560" Height="520" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="OnTitleMouseDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Updating FoxLauncher" Style="{StaticResource H1Text}"/>
                <TextBlock Text="The launcher is downloading and applying the latest version." Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="CloseButton" Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Padding="10,4" IsCancel="True" Click="OnCloseClick"/>
        </Grid>

        <!-- Version banner -->
        <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="10"
                Background="{DynamicResource AccentDarkBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="NewVersionLabel" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="OldVersionLabel" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="DownloadButton" Grid.Column="1" Content="Download &amp; install"
                        Style="{StaticResource PrimaryButton}" MinWidth="140" VerticalAlignment="Center"
                        Click="OnDownloadClick"/>
            </Grid>
        </Border>

        <!-- Release notes -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="What's new" Style="{StaticResource H2Text}"/>
            <TextBox x:Name="NotesText" Grid.Row="1" Style="{StaticResource InputTextBox}" Margin="0,8,0,0"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Padding="10,8" MinHeight="120"/>
        </Grid>

        <!-- Status / progress -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="ProgressBar" Style="{StaticResource AccentProgressBar}" Height="6"
                         IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterHint" Text="The launcher will close and restart automatically after a successful update."
                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="NotNowButton" Grid.Column="1" Content="Close" Style="{StaticResource GhostButton}"
                    MinWidth="90" IsCancel="True" Margin="0,0,10,0" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
