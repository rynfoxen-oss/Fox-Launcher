using System;
using System.Threading.Tasks;
using Launcher.Downloads;
using Launcher.ModManager;
using Launcher.Network;
using Launcher.Services;
using Launcher.Utils;

namespace Launcher.UI;

internal static class Program
{
    [STAThread]
    private static async Task<int> Main(string[] args)
    {
        if (args.Length > 0)
        {
            return await RunTestCommand(args);
        }

        // Normal UI startup
        var app = new App();
        app.InitializeComponent();
        return app.Run();
    }

    static async Task<int> RunTestCommand(string[] args)
    {
        try
        {
            var container = new DiContainer();
            container.RegisterInstance(new Http());
            container.Register<DownloadManager>(c => new DownloadManager(c.Resolve<Http>(), 8));
            container.Register<LogService>();
            container.Register<ModrinthApi>();
            container.Register<ModMetadataService>();
            container.Register<ModManagerService>();

            var log = container.Resolve<LogService>();
            var mods = container.Resolve<ModManagerService>();

            switch (args[0])
            {
                case "test-mod-list":
                    if (args.Length < 2) return ShowTestHelp();
                    var instanceId = args[1];
                    var modList = mods.ListMods(instanceId);
                    Console.WriteLine($"Found {modList.Count} mods in instance '{instanceId}':");
                    foreach (var modInfo in modList)
                    {
                        Console.WriteLine($"- {modInfo.FileName} ({(modInfo.Enabled ? "Enabled" : "Disabled")})");
                    }
                    return 0;

                case "test-mod-toggle":
                    if (args.Length < 3) return ShowTestHelp();
                    var instanceId3 = args[1];
                    var fileName = args[2];
                    var modList3 = mods.ListMods(instanceId3);
                    var modToToggle = modList3.FirstOrDefault(m => m.FileName == fileName);
                    if (modToToggle == null)
                    {
                        Console.WriteLine($"Mod '{fileName}' not found.");
                        return 1;
                    }
                    mods.ToggleMod(instanceId3, modToToggle);
                    Console.WriteLine($"Toggled mod: {modToToggle.FileName} (now {(modToToggle.Enabled ? "Enabled" : "Disabled")})");
                    return 0;

                case "test-mod-delete":
                    if (args.Length < 3) return ShowTestHelp();
                    var instanceId4 = args[1];
                    var fileName2 = args[2];
                    var modList4 = mods.ListMods(instanceId4);
                    var modToDelete = modList4.FirstOrDefault(m => m.FileName == fileName2);
                    if (modToDelete == null)
                    {
                        Console.WriteLine($"Mod '{fileName2}' not found.");
                        return 1;
                    }
                    mods.DeleteMod(instanceId4, modToDelete);
                    Console.WriteLine($"Deleted mod: {modToDelete.FileName}");
                    return 0;

                case "test-mod-import-folder":
                    if (args.Length < 3) return ShowTestHelp();
                    var instanceId5 = args[1];
                    var folderPath = args[2];
                    var count = mods.ImportFromFolder(instanceId5, folderPath);
                    Console.WriteLine($"Imported {count} mods from folder: {folderPath}");
                    return 0;

                case "test-mod-export-zip":
                    if (args.Length < 3) return ShowTestHelp();
                    var instanceId6 = args[1];
                    var zipPath = args[2];
                    mods.ExportAsZip(instanceId6, zipPath);
                    Console.WriteLine($"Exported mods to ZIP: {zipPath}");
                    return 0;

                case "test-mod-import-zip":
                    if (args.Length < 3) return ShowTestHelp();
                    var instanceId7 = args[1];
                    var zipPath2 = args[2];
                    mods.ImportFromZip(instanceId7, zipPath2);
                    Console.WriteLine($"Imported mods from ZIP: {zipPath2}");
                    return 0;

                case "test-mod-install":
                    if (args.Length < 3) return ShowTestHelp();
                    var instanceId2 = args[1];
                    var filePath = args[2];
                    var installedMod = mods.InstallLocal(instanceId2, filePath);
                    Console.WriteLine($"Installed mod: {installedMod.FileName}");
                    return 0;

                default:
                    return ShowTestHelp();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Test failed: {ex.Message}");
            return 1;
        }
    }

    static async Task<int> TestGameLaunch(string instanceId, DiContainer container)
    {
        try
        {
            container.Register<GameLauncherService>();
            container.Register<AccountManager>();
            container.Register<MicrosoftAuthService>();
            container.Register<OfflineAuthService>();
            
            var launcher = container.Resolve<GameLauncherService>();
            var accounts = container.Resolve<AccountManager>();
            
            // Ensure there's an active account
            if (accounts.Active == null)
            {
                Console.WriteLine("No active account. Creating offline account...");
                accounts.AddOfflineAccount("TestUser");
                accounts.SetActive(accounts.Accounts[0].Id);
            }
            
            Console.WriteLine($"Launching game for instance: {instanceId}");
            var result = await launcher.LaunchAsync(instanceId, "1.20.1", new LaunchOptions());
            
            if (result.Success)
            {
                Console.WriteLine("Game launched successfully!");
                return 0;
            }
            else
            {
                Console.WriteLine($"Game launch failed: {result.ErrorMessage}");
                return 1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Game launch test failed: {ex.Message}");
            return 1;
        }
    }
        Console.WriteLine("Available test commands:");
        Console.WriteLine("  test-mod-list <instanceId> - List mods in an instance");
        Console.WriteLine("  test-mod-install <instanceId> <filePath> - Install a local mod file");
        Console.WriteLine("  test-mod-toggle <instanceId> <fileName> - Toggle a mod's enabled state");
        Console.WriteLine("  test-mod-delete <instanceId> <fileName> - Delete a mod");
        Console.WriteLine("  test-mod-import-folder <instanceId> <folderPath> - Import mods from folder");
        Console.WriteLine("  test-mod-export-zip <instanceId> <zipPath> - Export mods to ZIP");
        Console.WriteLine("  test-mod-import-zip <instanceId> <zipPath> - Import mods from ZIP");
        return 1;
    }

