<Window x:Class="Launcher.UI.ModInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:net="clr-namespace:Launcher.Network;assembly=Launcher.Network"
        xmlns:conv="clr-namespace:Launcher.Views.Converters;assembly=Launcher.Views"
        Title="FoxLauncher — Mod Installer"
        Width="820" Height="640" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="OnTitleMouseDown">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:CompactNumberConverter x:Key="CompactNumber"/>
        <conv:BytesToSizeConverter x:Key="BytesToSize"/>

        <Style x:Key="InstallerPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="14,7" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Mod Installer" Style="{StaticResource H1Text}"/>
                <TextBlock x:Name="InstanceLabel" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Padding="10,4" IsCancel="True"/>
        </Grid>

        <!-- Source pills -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <RadioButton x:Name="BrowseRadio" Style="{StaticResource InstallerPill}" IsChecked="True"
                         GroupName="Source" Checked="OnSourceChanged">
                <TextBlock Text="Browse Modrinth"/>
            </RadioButton>
            <RadioButton x:Name="LocalRadio" Style="{StaticResource InstallerPill}" Margin="8,0,0,0"
                         GroupName="Source" Checked="OnSourceChanged">
                <TextBlock Text="Install local file"/>
            </RadioButton>
        </StackPanel>

        <!-- Browse section -->
        <Grid x:Name="BrowsePanel" Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}" VerticalContentAlignment="Center"
                         KeyDown="OnSearchKeyDown"/>
                <Button Grid.Column="1" Content="Search" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Click="OnSearchClick"/>
            </Grid>

            <!-- Results -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <ListBox x:Name="ResultsList" Style="{StaticResource PlainListBox}"
                         MaxHeight="170" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="OnResultSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type net:ModrinthHit}">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}"
                                        ClipToBounds="True" VerticalAlignment="Center">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding Downloads, Converter={StaticResource CompactNumber}, StringFormat='  {0} downloads'}"
                                                   Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding LatestVersion}" Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="SearchEmpty" Style="{StaticResource MutedText}" Text="Type a query and press Search, or press Search with an empty box to load popular mods."
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
            </Grid>
        </Grid>

        <!-- Local file section -->
        <StackPanel x:Name="LocalPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Choose a mod jar from your computer." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LocalPathBox" Style="{StaticResource InputTextBox}" IsReadOnly="True"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Click="OnBrowseClick"/>
            </Grid>
        </StackPanel>

        <!-- Version picker + install -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SelectedModTitle" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap"/>

            <ListBox x:Name="VersionList" Grid.Row="1" Style="{StaticResource PlainListBox}" Margin="0,10,0,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type net:ModrinthVersion}">
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VersionNumber}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Name, StringFormat='  {0}'}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding LoadersText}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                    <TextBlock Text="{Binding GameVersionsText}" Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Files[0].Size, Converter={StaticResource BytesToSize}}"
                                           Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DatePublishedText}"
                                           Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Progress -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <ProgressBar x:Name="ProgressBar" Style="{StaticResource AccentProgressBar}" Height="6"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="InstallButton" Grid.Column="2" Content="Install" Style="{StaticResource PrimaryButton}" MinWidth="110"
                    Click="OnInstallClick" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
