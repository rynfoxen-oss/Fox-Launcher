<Window x:Class="Launcher.UI.ChangeVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:net="clr-namespace:Launcher.Network;assembly=Launcher.Network"
        xmlns:conv="clr-namespace:Launcher.Views.Converters;assembly=Launcher.Views"
        Title="FoxLauncher — Change Version"
        Width="720" Height="600" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="OnTitleMouseDown">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BytesToSizeConverter x:Key="BytesToSize"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Change Version" Style="{StaticResource H1Text}"/>
                <TextBlock x:Name="ModTitle" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Padding="10,4" IsCancel="True"/>
        </Grid>

        <!-- Version list -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="VersionList" Style="{StaticResource PlainListBox}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type net:ModrinthVersion}">
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VersionNumber}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Name, StringFormat='  {0}'}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                    <Border Background="{DynamicResource AccentDarkBrush}" CornerRadius="4" Padding="5,1"
                                            Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Current" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding LoadersText}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    <TextBlock Text="{Binding GameVersionsText}" Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ConflictText}" Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version.Files[0].Size, Converter={StaticResource BytesToSize}}"
                                           Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Version.DatePublishedText}"
                                           Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Progress -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <ProgressBar x:Name="ProgressBar" Style="{StaticResource AccentProgressBar}" Height="6"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="ChangeButton" Grid.Column="2" Content="Change version" Style="{StaticResource PrimaryButton}" MinWidth="130"
                    Click="OnChangeClick" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
