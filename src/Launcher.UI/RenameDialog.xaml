<Window x:Class="Launcher.UI.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxLauncher" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource SurfaceBrush}"
        MouseLeftButtonDown="OnTitleMouseDown">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
        <TextBox x:Name="ValueBox" Style="{StaticResource InputTextBox}" MaxLength="60"
                 KeyDown="OnValueKeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="90"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="90"
                    Click="OnOkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
