<UserControl x:Class="Launcher.Views.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.Models;assembly=Launcher.Models"
             xmlns:conv="clr-namespace:Launcher.Views.Converters"
             xmlns:ctl="clr-namespace:Launcher.Views.Controls">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:CompactNumberConverter x:Key="CompactNumber"/>
        <conv:BytesToSizeConverter x:Key="BytesToSize"/>
        <conv:RelativeTimeConverter x:Key="RelativeTime"/>

        <!-- Tab pill style -->
        <Style x:Key="TabPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="16,8" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header (fixed) ===== -->
        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mods" Style="{StaticResource H1Text}"/>
                <TextBlock Grid.Column="1" Text="{Binding Mods.Count, StringFormat='  {0} installed'}" Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Instance" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Instances}" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedInstanceId, Mode=TwoWay}"
                              Style="{StaticResource InputComboBox}" Width="280"
                              IsEnabled="{Binding NoInstances, Converter={StaticResource InverseBoolean}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameInstance}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}"/>
                <ctl:ProgressRing Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"/>
                <ctl:ProgressRing Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}"/>
                <ctl:ProgressRing Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Search bar with suggestions -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding NoInstances, Converter={StaticResource InverseBoolean}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding CloseDetailCommand}"/>
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search Modrinth..." Foreground="{StaticResource TextSecondary}" FontStyle="Italic" Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Popup IsOpen="{Binding ShowSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="200" MaxHeight="200">
                            <ListBox ItemsSource="{Binding Suggestions}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="False"
                                     ScrollViewer.CanContentScroll="False"
                                     MouseLeftButtonUp="SuggestionList_MouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextPrimary}"
                                                       Margin="8,4"/>
                                            <TextBlock Text="{Binding Kind, StringFormat='({0})'}"
                                                       FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,4"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <Button Grid.Column="1" Content="Search" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBoolean}}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Update all" Style="{StaticResource GhostButton}"
                            Command="{Binding UpdateAllCommand}"
                            IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBoolean}}"/>
                    <TextBlock Text="{Binding UpdateCount, StringFormat='{}{0} updates'}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Import ZIP" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Command="{Binding ImportZipCommand}"/>
                <Button Grid.Column="4" Content="Mod Installer" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Command="{Binding OpenInstallerCommand}"/>
                <Button Grid.Column="5" Content="Install JAR" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Command="{Binding InstallLocalCommand}"/>
                <Button Grid.Column="6" Content="Open folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Command="{Binding OpenFolderCommand}"/>
                <Button Grid.Column="7" Content="Manage" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Click="OnManageMenuOpen">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Check for updates" Command="{Binding CheckUpdatesCommand}"/>
                            <MenuItem Header="Import mods from folder" Command="{Binding ImportFolderCommand}"/>
                            <Separator/>
                            <MenuItem Header="Export mods as ZIP" Command="{Binding ExportZipCommand}"/>
                            <MenuItem Header="Export mod manifest" Command="{Binding ExportManifestCommand}"/>
                            <Separator/>
                            <MenuItem Header="Roll back selected mod" Command="{Binding RollbackCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- Tabs -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <RadioButton Style="{StaticResource TabPill}"
                             IsChecked="{Binding InstalledTab, Mode=TwoWay}">
                    <TextBlock>
                        <Run Text="Installed"/>
                        <Run Text="{Binding Mods.Count, StringFormat='  ({0})', Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                    </TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource TabPill}" Margin="8,0,0,0"
                             IsChecked="{Binding BrowseTab, Mode=TwoWay}">
                    <TextBlock>
                        <Run Text="Browse Modrinth"/>
                        <Run Text="{Binding SearchResults.Count, StringFormat='  ({0})', Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                    </TextBlock>
                </RadioButton>
            </StackPanel>

            <!-- Batch action bar (installed tab only) -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding IsInstalledVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding SelectedMods.Count, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SelectedMods.Count, StringFormat='{}{0} selected'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Enable" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding BatchEnableCommand}"/>
                    <Button Content="Disable" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding BatchDisableCommand}"/>
                    <Button Content="Update" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding UpdateSelectedCommand}"/>
                    <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,4,0" Command="{Binding BatchDeleteCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Sort + category (browse tab only) -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,16"
                        Visibility="{Binding IsBrowseVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="Sort by" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                              Style="{StaticResource InputComboBox}" Width="180"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Category" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              Style="{StaticResource InputComboBox}" Width="200"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ===== Content (scrolls) ===== -->
        <Grid Grid.Row="1" Margin="28,0,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Main content area -->
            <Grid Grid.Column="0">
                <!-- No-instances empty state -->
                <Border Style="{StaticResource CardPanel}" Padding="24" MaxWidth="520" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Visibility="{Binding NoInstances, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="No instances yet" Style="{StaticResource H2Text}"/>
                        <TextBlock Text="Create or import an instance first — the mods page is per-instance."
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Button Content="Go to Instances" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Command="{Binding GoToInstancesCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Sections: visible when at least one instance exists -->
                <Grid Visibility="{Binding NoInstances, Converter={StaticResource InverseBoolToVisibility}}">

                    <!-- ===== Installed mods ===== -->
                    <Grid Visibility="{Binding IsInstalledVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                                        <Setter Property="Padding" Value="16"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mods.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="No mods installed yet" Style="{StaticResource H2Text}"/>
                                    <TextBlock Text="Search Modrinth in the Browse tab, or install a local jar."
                                               Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="InstalledList" ItemsSource="{Binding Mods}"
                                     SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                                     SelectionMode="Multiple"
                                     SelectionChanged="InstalledList_SelectionChanged"
                                     PreviewMouseWheel="OnListBoxPreviewMouseWheel"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource PlainListBox}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mods.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="12" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44" Height="44" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}"
                                                        ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                        <Border Style="{StaticResource ModBadge}" Background="{StaticResource SurfaceBrush}"
                                                                Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibility}}">
                                                            <TextBlock Text="Disabled" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource ModBadge}" Background="{StaticResource AccentDarkBrush}"
                                                                Visibility="{Binding ProjectId, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                                                            <TextBlock Text="Modrinth" FontSize="10" Foreground="{StaticResource TextPrimary}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource ModBadge}" Background="{StaticResource AccentBrush}"
                                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Update available" FontSize="10" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource CaptionText}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                                        <TextBlock Text="{Binding Version, StringFormat='  v{0}'}"
                                                                   Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding Size, Converter={StaticResource BytesToSize}, StringFormat='  {0}'}"
                                                                   Style="{StaticResource CaptionText}"/>
                                                        <TextBlock Text="{Binding InstalledAt, Converter={StaticResource RelativeTime}, StringFormat='  installed {0}'}"
                                                                   Style="{StaticResource CaptionText}"/>
                                                        <TextBlock Text="{Binding Authors.Count, StringFormat='  by {0} author(s)'}"
                                                                   Style="{StaticResource CaptionText}" Visibility="{Binding Authors.Count, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Style="{StaticResource AccentCheckBox}"
                                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                              CommandParameter="{Binding}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                        <Button Content="Update" Style="{StaticResource GhostButton}"
                                                                Command="{Binding DataContext.UpdateSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
                                                        <Button Content="Remove" Style="{StaticResource DangerButton}" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                    <!-- ===== Browse Modrinth ===== -->
                    <Grid Visibility="{Binding IsBrowseVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                                        <Setter Property="Padding" Value="16"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSearched}" Value="True"/>
                                                    <Condition Binding="{Binding SearchResults.Count}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="No mods found" Style="{StaticResource H2Text}"/>
                                    <TextBlock Text="Try a different query, sort or category, or check that the selected instance's version/loader is supported."
                                               Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                     PreviewMouseWheel="OnListBoxPreviewMouseWheel"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource PlainListBox}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchResults.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}"
                                                        ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                                        <Border Style="{StaticResource ModBadge}" Background="{StaticResource AccentDarkBrush}"
                                                                Visibility="{Binding Installed, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Installed" FontSize="10" Foreground="{StaticResource TextPrimary}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionText}"/>
                                                        <TextBlock Text="{Binding Downloads, Converter={StaticResource CompactNumber}, StringFormat='  {0} downloads'}"
                                                                   Style="{StaticResource CaptionText}"/>
                                                        <TextBlock Text="{Binding LatestVersion, StringFormat='  Latest: {0}'}"
                                                                   Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding DateModified, Converter={StaticResource RelativeTime}, StringFormat='  Updated {0}'}"
                                                                   Style="{StaticResource CaptionText}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <Button Content="Details" Style="{StaticResource GhostButton}"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.SelectModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Install" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.InstallSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.IsInstalling, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolean}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                </Grid>
            </Grid>

            <!-- ===== Detail drawer (right side) ===== -->
            <Border Grid.Column="1" Width="360" Margin="12,0,0,0"
                    Visibility="{Binding ShowDetailDrawer, Converter={StaticResource BoolToVisibility}}"
                    Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Mod Details" Style="{StaticResource H2Text}"/>
                            <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    Command="{Binding CloseDetailCommand}" Padding="8,2"/>
                        </Grid>

                        <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <Image Source="{Binding DetailMod.IconUrl}" Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailMod.IconUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>

                        <TextBlock Text="{Binding DetailMod.Title}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource ModBadge}" Background="{StaticResource AccentDarkBrush}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Visibility="{Binding DetailMod.Installed, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Installed" FontSize="10" Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                        <TextBlock Text="{Binding DetailMod.Description}" Style="{StaticResource MutedText}" Margin="0,8,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="Actions" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                        <Button Content="Install" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                Command="{Binding InstallSelectedCommand}"
                                CommandParameter="{Binding DetailMod}"
                                IsEnabled="{Binding DetailMod.Installed, Converter={StaticResource InverseBoolean}}"/>
                        <Button Content="View on Modrinth" Style="{StaticResource GhostButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                Command="{Binding OpenModrinthCommand}"/>

                        <TextBlock Text="Info" Style="{StaticResource SectionTitleText}" Margin="0,12,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Author:" Style="{StaticResource CaptionText}" Width="72"/>
                            <TextBlock Text="{Binding DetailMod.Author}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Downloads:" Style="{StaticResource CaptionText}" Width="72"/>
                            <TextBlock Text="{Binding DetailMod.Downloads, Converter={StaticResource CompactNumber}}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Followers:" Style="{StaticResource CaptionText}" Width="72"/>
                            <TextBlock Text="{Binding DetailMod.Follows, Converter={StaticResource CompactNumber}}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Latest:" Style="{StaticResource CaptionText}" Width="72"/>
                            <TextBlock Text="{Binding DetailMod.LatestVersion}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Updated:" Style="{StaticResource CaptionText}" Width="72"/>
                            <TextBlock Text="{Binding DetailMod.DateModified, Converter={StaticResource RelativeTime}}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding DetailMod.Categories.Count, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Categories:" Style="{StaticResource CaptionText}" Width="72"/>
                            <ItemsControl ItemsSource="{Binding DetailMod.Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
