<UserControl x:Class="Launcher.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Views.Converters">
    <UserControl.Resources>
        <conv:ColorToBrushConverter x:Key="ColorToBrush"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <TextBlock Text="Settings" Style="{StaticResource H1Text}"/>
            <TextBlock Text="Configure launcher performance, appearance, and behavior." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="28,16,28,28" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Java &amp; memory" Style="{StaticResource H2Text}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Max memory" Style="{StaticResource CaptionText}"/>
                                <Slider Minimum="1024" Maximum="16384" TickFrequency="1024" IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.MaxMemoryMb, Mode=TwoWay}" Style="{StaticResource AccentSlider}"/>
                                <TextBlock Text="{Binding Settings.MaxMemoryMb, StringFormat={}{0} MB}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Min memory" Style="{StaticResource CaptionText}"/>
                                <Slider Minimum="256" Maximum="8192" TickFrequency="256" IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.MinMemoryMb, Mode=TwoWay}" Style="{StaticResource AccentSlider}"/>
                                <TextBlock Text="{Binding Settings.MinMemoryMb, StringFormat={}{0} MB}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Java path" Style="{StaticResource CaptionText}" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Settings.JavaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Command="{Binding BrowseJavaCommand}"/>
                            <Button Grid.Column="2" Content="Auto detect" Style="{StaticResource GhostButton}" Command="{Binding DetectJavaCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding JavaStatus}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Window" Style="{StaticResource H2Text}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Width" Style="{StaticResource CaptionText}"/>
                                <TextBox Text="{Binding Settings.WindowWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Height" Style="{StaticResource CaptionText}"/>
                                <TextBox Text="{Binding Settings.WindowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBox}"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,18,0,0" ItemHeight="30" ItemWidth="220" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox Content="Fullscreen" Style="{StaticResource AccentCheckBox}"
                                      IsChecked="{Binding Settings.Fullscreen, Mode=TwoWay}"/>
                            <CheckBox Content="Show FPS" Style="{StaticResource AccentCheckBox}"
                                      IsChecked="{Binding Settings.ShowFps, Mode=TwoWay}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource H2Text}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Theme, Mode=TwoWay}"
                                      Style="{StaticResource InputComboBox}" Width="160" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Accent" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <ItemsControl Grid.Column="3" ItemsSource="{Binding AccentColors}" Margin="12,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="22" Height="22" Margin="3" Cursor="Hand"
                                                Command="{Binding DataContext.AccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="11"
                                                            Background="{Binding Converter={StaticResource ColorToBrush}}"
                                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                                            BorderThickness="1"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <TextBlock Text="Click a color to apply it immediately." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Behavior" Style="{StaticResource H2Text}"/>
                        <UniformGrid Columns="2" Margin="0,18,0,0" HorizontalAlignment="Left">
                            <CheckBox Content="Close launcher after game starts" Style="{StaticResource AccentCheckBox}"
                                      IsChecked="{Binding Settings.CloseAfterLaunch, Mode=TwoWay}" Margin="0,0,16,12"/>
                            <CheckBox Content="Enable Discord Rich Presence" Style="{StaticResource AccentCheckBox}"
                                      IsChecked="{Binding Settings.EnableDiscordRpc, Mode=TwoWay}" Margin="0,0,0,12"/>
                            <CheckBox Content="Check for updates automatically" Style="{StaticResource AccentCheckBox}"
                                      IsChecked="{Binding Settings.AutoUpdate, Mode=TwoWay}" Margin="0,0,16,12"/>
                            <CheckBox Content="Auto-detect Java on startup" Style="{StaticResource AccentCheckBox}"
                                      IsChecked="{Binding Settings.AutoJavaDetect, Mode=TwoWay}" Margin="0,0,0,12"/>
                            <CheckBox Content="Background music" Style="{StaticResource AccentCheckBox}"
                                      IsChecked="{Binding Settings.BackgroundMusic, Mode=TwoWay}" Margin="0,0,16,0"/>
                        </UniformGrid>
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="Music volume" Style="{StaticResource CaptionText}"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Settings.MusicVolume, Mode=TwoWay}"
                                    Style="{StaticResource AccentSlider}"/>
                            <TextBlock Text="{Binding Settings.MusicVolume, StringFormat={}{0}%}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <WrapPanel Margin="0,20,0,0" Orientation="Horizontal" ItemHeight="36" ItemWidth="180">
                            <Button Content="Create desktop shortcut" Style="{StaticResource GhostButton}" Command="{Binding CreateShortcutCommand}"/>
                            <Button Content="Open launcher folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding OpenLauncherFolderCommand}"/>
                            <Button Content="Open logs folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Command="{Binding OpenLogsFolderCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource H2Text}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="FoxLauncher" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="A modern, open-source Minecraft launcher." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                            <Button Content="Check for updates" Style="{StaticResource GhostButton}" Command="{Binding CheckForUpdatesCommand}"/>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
