<UserControl x:Class="Launcher.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Views.Converters"
             xmlns:controls="clr-namespace:Launcher.Views.Controls">
    <UserControl.Resources>
        <conv:ColorToBrushConverter x:Key="ColorToBrush"/>
        <DataTemplate x:Key="LanguageOptionTemplate">
            <TextBlock Text="{Binding Name}"/>
        </DataTemplate>

        <!-- Bigger, easier-to-read and easier-to-use settings controls -->
        <Style x:Key="SettingsCaptionText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SettingsMutedText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="SettingsH2Text" TargetType="TextBlock" BasedOn="{StaticResource H2Text}">
            <Setter Property="FontSize" Value="19"/>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="SettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource InputComboBox}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <Style x:Key="SettingsToggle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="54" Height="30" CornerRadius="15"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="{DynamicResource TextSecondary}"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <TextBlock x:Name="Label" Grid.Column="1" Margin="14,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"
                                       FontSize="14.5" Text="{TemplateBinding Content}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="{x:Type controls:JumpSlider}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:JumpSlider}">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="PART_Track" Height="6" CornerRadius="3" Margin="12,0" VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceHoverBrush}"/>
                            <Border x:Name="PART_Fill" Height="6" CornerRadius="3" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"/>
                            <!-- ClipToBounds stays off on purpose: the knob is positioned
                                 with Canvas.Left/Top and must always render in full, even at
                                 the ends of the bar. -->
                            <Canvas IsHitTestVisible="False" ClipToBounds="False" SnapsToDevicePixels="True">
                                <Border x:Name="PART_Thumb" Width="18" Height="18" CornerRadius="9" SnapsToDevicePixels="True"
                                        Background="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"/>
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PART_Thumb" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource SettingsMutedText}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="MemoryValueBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NumericTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentGlowBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,14,20,0">
            <TextBlock Text="Settings" Style="{StaticResource H1Text}"/>
            <TextBlock Text="Configure launcher performance, appearance, and behavior." Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Section navigation + search ===== -->
            <Grid Grid.Column="0" Margin="0,14,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SettingsTextBox}" ToolTip="Search settings by name or topic"/>

                <ListBox x:Name="SectionList" Grid.Row="1" Style="{StaticResource NavListBox}" Margin="0,10,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         SelectionChanged="OnSectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8" ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource BaseText}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ===== Section content ===== -->
            <ScrollViewer x:Name="ContentScroller" Grid.Column="1" Padding="0,8,0,0"
                          VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                    <!-- ============ Launcher ============ -->
                    <Grid x:Name="LauncherSection">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Startup" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="What you see when the launcher opens." Style="{StaticResource SettingsMutedText}"/>

                                    <TextBlock Text="Page on startup" Style="{StaticResource SettingsCaptionText}" Margin="0,18,0,8"/>
                                    <ComboBox ItemsSource="{Binding StartupPages}"
                                              SelectedItem="{Binding SelectedStartupPage, Mode=TwoWay}"
                                              Style="{StaticResource SettingsComboBox}" Width="240" HorizontalAlignment="Left"/>
                                    <TextBlock Text="The first page shown after the launcher loads." Style="{StaticResource SettingsMutedText}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Behavior" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="How the launcher runs while you use it." Style="{StaticResource SettingsMutedText}"/>

                                    <StackPanel Margin="0,18,0,0">
                                        <CheckBox Content="Close launcher after game starts" Style="{StaticResource SettingsToggle}"
                                                  IsChecked="{Binding Settings.CloseAfterLaunch, Mode=TwoWay}"/>
                                        <TextBlock Text="Closes the launcher once the game window appears." Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>

                                        <CheckBox Content="Confirm before launching" Style="{StaticResource SettingsToggle}" Margin="0,18,0,0"
                                                  IsChecked="{Binding Settings.ConfirmBeforeLaunch, Mode=TwoWay}"/>
                                        <TextBlock Text="Ask before starting a game." Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>

                                        <CheckBox Content="Check for updates automatically" Style="{StaticResource SettingsToggle}" Margin="0,18,0,0"
                                                  IsChecked="{Binding Settings.AutoUpdate, Mode=TwoWay}"/>
                                        <TextBlock Text="Automatically look for a new version on startup." Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>

                                        <CheckBox Content="Auto-detect Java on startup" Style="{StaticResource SettingsToggle}" Margin="0,18,0,0"
                                                  IsChecked="{Binding Settings.AutoJavaDetect, Mode=TwoWay}"/>
                                        <TextBlock Text="Search for an installed Java runtime automatically." Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>

                                        <CheckBox Content="Create desktop shortcut on install" Style="{StaticResource SettingsToggle}" Margin="0,18,0,0"
                                                  IsChecked="{Binding Settings.CreateDesktopShortcut, Mode=TwoWay}"/>
                                        <TextBlock Text="Add a FoxLauncher shortcut to the desktop during installation." Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ Game & Java ============ -->
                    <Grid x:Name="GameSection" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Java &amp; memory" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="How much memory to give the game and which Java to use." Style="{StaticResource SettingsMutedText}"/>

                                    <!-- ===== Memory allocation ===== -->
                                    <TextBlock Text="MEMORY ALLOCATION" Style="{StaticResource SettingsSectionHeaderText}" Margin="0,24,0,14"/>

                                    <!-- Maximum memory -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="MAXIMUM MEMORY" Style="{StaticResource SettingsSectionHeaderText}"/>
                                            <TextBlock Text="The largest heap the game may use (-Xmx)." Style="{StaticResource SettingsMutedText}" FontSize="11.5" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource MemoryValueBox}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding MaxMemoryText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource NumericTextBox}" Width="72"
                                                         ToolTip="Maximum memory (maximum heap, -Xmx). Step 512 MB."/>
                                                <TextBlock Text="MB" Style="{StaticResource SettingsMutedText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <controls:JumpSlider Minimum="{Binding MaxSliderMinimum}" Maximum="{Binding MaxSliderMaximum}"
                                                         TickFrequency="512" IsSnapToTickEnabled="True"
                                                         Value="{Binding Settings.MaxMemoryMb, Mode=TwoWay}" Style="{StaticResource SettingsSlider}"
                                                         Margin="0,6,0,0"/>

                                    <!-- Minimum memory -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="MINIMUM MEMORY" Style="{StaticResource SettingsSectionHeaderText}"/>
                                            <TextBlock Text="The heap size reserved when the game starts (-Xms)." Style="{StaticResource SettingsMutedText}" FontSize="11.5" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource MemoryValueBox}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding MinMemoryText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource NumericTextBox}" Width="72"
                                                         ToolTip="Minimum memory (initial heap, -Xms). Step 512 MB."/>
                                                <TextBlock Text="MB" Style="{StaticResource SettingsMutedText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <controls:JumpSlider Minimum="{Binding MinSliderMinimum}" Maximum="{Binding MinSliderMaximum}"
                                                         TickFrequency="512" IsSnapToTickEnabled="True"
                                                         Value="{Binding Settings.MinMemoryMb, Mode=TwoWay}" Style="{StaticResource SettingsSlider}"
                                                         Margin="0,6,0,0"/>

                                    <TextBlock Text="{Binding SystemMemoryText}" Style="{StaticResource SettingsMutedText}" FontSize="11.5" Margin="0,16,0,0"/>
                                    <TextBlock Text="{Binding MemoryValidationMessage}" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsMutedText}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MemoryWarning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- ===== Java runtime ===== -->
                                    <TextBlock Text="JAVA RUNTIME" Style="{StaticResource SettingsSectionHeaderText}" Margin="0,26,0,14"/>

                                    <TextBlock Text="Java path" Style="{StaticResource SettingsCaptionText}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Settings.JavaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBox}" Margin="0,0,10,0"
                                                 ToolTip="{Binding Settings.JavaPath}"/>
                                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Command="{Binding BrowseJavaCommand}"/>
                                        <Button Grid.Column="2" Content="Auto detect" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding DetectJavaCommand}"/>
                                    </Grid>

                                    <TextBlock Text="{Binding JavaStatus}" TextWrapping="Wrap" Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsMutedText}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding JavaStatusKind}" Value="1">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding JavaStatusKind}" Value="2">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding RecommendedJavaText}" TextWrapping="Wrap" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsMutedText}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecommendedJavaKind}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RecommendedJavaKind}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Window" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="The size and mode the game starts in." Style="{StaticResource SettingsMutedText}"/>

                                    <TextBlock Text="Resolution" Style="{StaticResource SettingsCaptionText}" Margin="0,18,0,8"/>
                                    <ComboBox ItemsSource="{Binding ResolutionPresets}" DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedResolutionPreset, Mode=TwoWay}"
                                              Style="{StaticResource SettingsComboBox}" Width="240" HorizontalAlignment="Left"/>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Width" Style="{StaticResource SettingsCaptionText}"/>
                                            <TextBox Text="{Binding Settings.WindowWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Height" Style="{StaticResource SettingsCaptionText}"/>
                                            <TextBox Text="{Binding Settings.WindowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,18,0,0">
                                        <CheckBox Content="Fullscreen" Style="{StaticResource SettingsToggle}"
                                                  IsChecked="{Binding Settings.Fullscreen, Mode=TwoWay}"/>
                                        <TextBlock Text="Launch the game in fullscreen mode." Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>
                                        <CheckBox Content="Show FPS" Style="{StaticResource SettingsToggle}" Margin="0,18,0,0"
                                                  IsChecked="{Binding Settings.ShowFps, Mode=TwoWay}"/>
                                        <TextBlock Text="Display an FPS counter in the corner of the game." Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ Performance ============ -->
                    <Grid x:Name="PerformanceSection" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Game performance" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="JVM tuning that reduces hitches while you play." Style="{StaticResource SettingsMutedText}"/>

                                    <Grid Margin="0,18,0,0">
                                        <TextBlock Text="Max GC pause (ms)" Style="{StaticResource SettingsCaptionText}"/>
                                        <TextBlock Text="{Binding Settings.GcPauseMillis, StringFormat={}{0} ms}"
                                                   Style="{StaticResource SettingsMutedText}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <controls:JumpSlider Minimum="10" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.GcPauseMillis, Mode=TwoWay}" Style="{StaticResource SettingsSlider}"/>
                                    <TextBlock Text="Lower values keep the game frame rate steadier, higher values reduce CPU overhead."
                                               Style="{StaticResource SettingsMutedText}"/>

                                    <StackPanel Margin="0,18,0,0">
                                        <CheckBox Content="Pre-touch memory at startup" Style="{StaticResource SettingsToggle}"
                                                  IsChecked="{Binding Settings.AlwaysPreTouch, Mode=TwoWay}"/>
                                        <TextBlock Text="Allocates memory up front. Slower to start, smoother during play."
                                                   Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>

                                        <CheckBox Content="Multicore optimizations" Style="{StaticResource SettingsToggle}" Margin="0,18,0,0"
                                                  IsChecked="{Binding Settings.MultiCoreOptimization, Mode=TwoWay}"/>
                                        <TextBlock Text="Adds flags that reduce garbage-collection hitches on multicore CPUs."
                                                   Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>

                                        <CheckBox Content="Boost FPS" Style="{StaticResource SettingsToggle}" Margin="0,18,0,0"
                                                  IsChecked="{Binding Settings.BoostFps, Mode=TwoWay}"/>
                                        <TextBlock Text="Tuned JVM flags, optimized in-game graphics defaults, and automatic performance mods (Sodium, Lithium, Krypton, ModernFix, ... on Fabric; Embeddium, Canary, ModernFix, ... on Forge). Incompatible mods are skipped."
                                                   Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="Extra JVM arguments" Style="{StaticResource SettingsCaptionText}" Margin="0,18,0,8"/>
                                    <TextBox Text="{Binding Settings.JvmArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextBox}" Height="42" VerticalContentAlignment="Center"
                                             ToolTip="Example: -Dlog4j2.formatMsgNoLookups=true -XX:+UseAESIntrinsics"/>
                                    <TextBlock Text="Appended to the Java command line, separated by spaces. For advanced users."
                                               Style="{StaticResource SettingsMutedText}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ Appearance ============ -->
                    <Grid x:Name="AppearanceSection" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="Pick the launcher's overall look." Style="{StaticResource SettingsMutedText}"/>
                                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Theme, Mode=TwoWay}"
                                              Style="{StaticResource SettingsComboBox}" Width="220" HorizontalAlignment="Left" Margin="0,16,0,0"/>

                                    <CheckBox Content="Reduce UI effects" Style="{StaticResource SettingsToggle}" Margin="0,24,0,0"
                                              IsChecked="{Binding Settings.DisableAnimations, Mode=TwoWay}"/>
                                    <TextBlock Text="Removes card shadows and animations. Smoother on low-end machines, flatter look."
                                               Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Accent color" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="Click a color to apply it immediately." Style="{StaticResource SettingsMutedText}"/>
                                    <ItemsControl ItemsSource="{Binding AccentColors}" Margin="0,16,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="26" Height="26" Margin="4" Cursor="Hand"
                                                        Command="{Binding DataContext.AccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="13"
                                                                    Background="{Binding Converter={StaticResource ColorToBrush}}"
                                                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                                                    BorderThickness="1"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ Downloads ============ -->
                    <Grid x:Name="DownloadsSection" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Download speed" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="How many files the launcher downloads at once." Style="{StaticResource SettingsMutedText}"/>

                                    <Grid Margin="0,18,0,0">
                                        <TextBlock Text="Parallel downloads" Style="{StaticResource SettingsCaptionText}"/>
                                        <TextBlock Text="{Binding Settings.DownloadThreads, StringFormat={}{0} threads}"
                                                   Style="{StaticResource SettingsMutedText}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <controls:JumpSlider Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.DownloadThreads, Mode=TwoWay}" Style="{StaticResource SettingsSlider}"/>
                                    <TextBlock Text="Used for Minecraft versions, libraries, mods, shaders and resource packs."
                                               Style="{StaticResource SettingsMutedText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ General ============ -->
                    <Grid x:Name="GeneralSection" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Language &amp; audio" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="Interface language and background music." Style="{StaticResource SettingsMutedText}"/>

                                    <TextBlock Text="Language" Style="{StaticResource SettingsCaptionText}" Margin="0,18,0,8"/>
                                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code"
                                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource LanguageOptionTemplate}"
                                              Style="{StaticResource SettingsComboBox}" Width="220" HorizontalAlignment="Left"/>

                                    <CheckBox Content="Play background music" Style="{StaticResource SettingsToggle}" Margin="0,24,0,0"
                                              IsChecked="{Binding Settings.BackgroundMusic, Mode=TwoWay}"/>
                                    <TextBlock Text="Music volume" Style="{StaticResource SettingsCaptionText}" Margin="0,16,0,6"/>
                                    <controls:JumpSlider Minimum="0" Maximum="100" Value="{Binding Settings.MusicVolume, Mode=TwoWay}"
                                            Style="{StaticResource SettingsSlider}" IsEnabled="{Binding Settings.BackgroundMusic}"/>
                                    <TextBlock Text="{Binding Settings.MusicVolume, StringFormat={}{0}%}" Style="{StaticResource SettingsMutedText}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Integration" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="Connect the launcher to other apps." Style="{StaticResource SettingsMutedText}"/>

                                    <CheckBox Content="Enable Discord Rich Presence" Style="{StaticResource SettingsToggle}" Margin="0,18,0,0"
                                              IsChecked="{Binding Settings.EnableDiscordRpc, Mode=TwoWay}"/>
                                    <TextBlock Text="Show what you're playing on Discord." Style="{StaticResource SettingsMutedText}" Margin="56,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ About ============ -->
                    <Grid x:Name="AboutSection" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="About" Style="{StaticResource SettingsH2Text}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <TextBlock Text="FoxLauncher" Style="{StaticResource SectionTitleText}"/>
                                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource SettingsMutedText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="A modern, open-source Minecraft launcher." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                                        <Button Content="Check for updates" Style="{StaticResource GhostButton}" Command="{Binding CheckForUpdatesCommand}"/>
                                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource SettingsMutedText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============ Maintenance ============ -->
                    <Grid x:Name="MaintenanceSection" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Shortcuts &amp; folders" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="Quick access to launcher folders and shortcuts." Style="{StaticResource SettingsMutedText}"/>
                                    <WrapPanel Margin="0,16,0,0" Orientation="Horizontal" ItemHeight="40" ItemWidth="210">
                                        <Button Content="Create desktop shortcut" Style="{StaticResource GhostButton}" Command="{Binding CreateShortcutCommand}"/>
                                        <Button Content="Open launcher folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                                Command="{Binding OpenLauncherFolderCommand}"/>
                                        <Button Content="Open logs folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                                Command="{Binding OpenLogsFolderCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Uninstall FoxLauncher" Style="{StaticResource SettingsH2Text}"/>
                                    <TextBlock Text="Remove FoxLauncher from this computer. Your saved instances, worlds, mods and settings are kept in the launcher folder and won't be touched unless you delete them."
                                               Style="{StaticResource SettingsMutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                                        <Button Content="Uninstall…" Style="{StaticResource DangerButton}" Command="{Binding UninstallCommand}"
                                                ToolTip="Launch the uninstaller. The launcher will close."/>
                                        <TextBlock Text="Opens the graphical uninstaller." Style="{StaticResource SettingsMutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
