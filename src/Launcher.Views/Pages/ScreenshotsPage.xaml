<UserControl x:Class="Launcher.Views.Pages.ScreenshotsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Views.Converters">
    <UserControl.Resources>
        <conv:RelativeTimeConverter x:Key="RelativeTime"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Screenshots" Style="{StaticResource H1Text}"/>
                <Button Content="Open folder" Style="{StaticResource GhostButton}" Margin="20,0,0,0"
                        VerticalAlignment="Center" Command="{Binding OpenFolderCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,16,28,28">
            <ListBox ItemsSource="{Binding Shots}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Style="{StaticResource PlainListBox}" Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,16,16" Padding="10">
                            <StackPanel Width="220">
                                <Border CornerRadius="6" ClipToBounds="True" Background="{StaticResource SurfaceAltBrush}"
                                        Cursor="Hand">
                                    <Image Source="{Binding FullPath}" Stretch="UniformToFill" MaxHeight="140">
                                        <Image.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                        </Image.InputBindings>
                                    </Image>
                                </Border>
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding TakenAt, Converter={StaticResource RelativeTime}}" Style="{StaticResource CaptionText}"/>
                                    <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="Auto,0,0,0"
                                            Padding="8,3"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                        <Setter Property="Padding" Value="24"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Shots.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="No screenshots yet. Press F2 in-game to capture them; they appear here."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
