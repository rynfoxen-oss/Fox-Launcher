<UserControl x:Class="Launcher.Views.Pages.ShadersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Views.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Shaders" Style="{StaticResource H1Text}"/>
                <Button Content="Import shader" Style="{StaticResource PrimaryButton}" Margin="20,0,0,0"
                        VerticalAlignment="Center" Command="{Binding ImportCommand}"/>
                <Button Content="Open folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        VerticalAlignment="Center" Command="{Binding OpenFolderCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,16,28,28">
            <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Style="{StaticResource PlainListBox}"
                     Visibility="{Binding Packs.Count, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}" ClipToBounds="True">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}"/>
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Margin="8,0,0,0"
                                                Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="540"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Remove" Style="{StaticResource DangerButton}" VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                        <Setter Property="Padding" Value="24"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Packs.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="No shader packs yet. Import a ZIP above, or drop packs into the folder."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
