<UserControl x:Class="Launcher.Views.Pages.WorldsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Views.Converters">
    <UserControl.Resources>
        <conv:RelativeTimeConverter x:Key="RelativeTime"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Worlds" Style="{StaticResource H1Text}"/>
                <Button Content="Open saves folder" Style="{StaticResource GhostButton}" Margin="20,0,0,0"
                        VerticalAlignment="Center" Command="{Binding OpenFolderCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,16,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <ListBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Style="{StaticResource PlainListBox}"
                         Visibility="{Binding Worlds.Count, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}" ClipToBounds="True">
                                        <Image Source="{Binding IconPath}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding GameMode}" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding Difficulty}" Style="{StaticResource CaptionText}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Backup" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.BackupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                            <Setter Property="Padding" Value="24"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Worlds.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="No worlds yet. Play the selected instance and create a world in-game — it appears here."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Backups" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Text="Select a backup to restore into the current world." Style="{StaticResource MutedText}" Margin="0,6,0,12"/>
                    <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                             Style="{StaticResource PlainListBox}" MaxHeight="300"
                             Visibility="{Binding Backups.Count, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="6,3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No backups yet. Use the Backup button on a world."
                               Margin="0,6,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Restore" Style="{StaticResource PrimaryButton}" Command="{Binding RestoreCommand}"/>
                        <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Command="{Binding RefreshBackupsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
