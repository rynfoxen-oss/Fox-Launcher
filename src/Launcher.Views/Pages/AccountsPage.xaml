<UserControl x:Class="Launcher.Views.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Launcher.Views.Controls"
             xmlns:conv="clr-namespace:Launcher.Views.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <TextBlock Text="Accounts" Style="{StaticResource H1Text}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="28,16,28,28" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Add account" Style="{StaticResource H2Text}"/>
                        <TextBlock Text="Sign in with your Microsoft account, or use an offline profile for single-player."
                                   Style="{StaticResource MutedText}" Margin="0,6,0,14"/>
                        <Button Content="Sign in with Microsoft" Style="{StaticResource PrimaryButton}" MinWidth="220"
                                HorizontalAlignment="Left" Command="{Binding MicrosoftLoginCommand}"/>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="16" Margin="0,16,0,0"
                                Visibility="{Binding ShowDeviceCode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Sign in on another device" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="{Binding VerificationUri, StringFormat='Go to {0} and enter this code:'}"
                                           Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="18,10">
                                        <TextBlock Text="{Binding DeviceCode}" FontFamily="Consolas" FontSize="22"
                                                   FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <Button Content="Copy" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Command="{Binding CopyCodeCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OfflineNameBox" Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     ToolTip="Player name for the offline profile"/>
                            <Button Grid.Column="1" Content="Add offline profile" Style="{StaticResource GhostButton}"
                                    Margin="10,0,0,0" Command="{Binding OfflineLoginCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16"
                        Visibility="{Binding HasActiveAccount, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Player skin" Style="{StaticResource H2Text}" VerticalAlignment="Center"/>
                            <CheckBox Content="3D preview" IsChecked="{Binding SkinPreview3D}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" Style="{StaticResource AccentCheckBox}"
                                      ToolTip="Show the skin on an interactive 3D model"/>
                        </StackPanel>
                        <TextBlock Text="Preview and change the skin worn by this account in-game. Drag the figure to orbit, scroll to zoom."
                                   Style="{StaticResource MutedText}" Margin="0,6,0,14"/>
                        <Grid Visibility="{Binding SkinPreview3D, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="12"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <ctl:SkinViewer Width="150" Height="198" TextureUrl="{Binding ActiveSkinUrl}"
                                                    ShowBody="True" SkinVariant="{Binding ActiveSkinVariant}"
                                                    ModelPreference="{Binding SkinModelPreference}"
                                                    AnimationEnabled="{Binding SkinAnimation}"
                                                    RenderQuality="{Binding SkinPreviewQuality}"/>
                                </Border>
                                <TextBlock Text="{Binding SkinHint}" Style="{StaticResource CaptionText}"
                                           MaxWidth="150" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="Model:" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <RadioButton Content="Auto" GroupName="SkinModel" Margin="12,0,0,0"
                                                 IsChecked="{Binding IsModelAuto}"
                                                 ToolTip="Use the account's declared model, otherwise detect from the texture"/>
                                    <RadioButton Content="Classic" GroupName="SkinModel" Margin="10,0,0,0"
                                                 IsChecked="{Binding IsModelClassic}"/>
                                    <RadioButton Content="Slim" GroupName="SkinModel" Margin="10,0,0,0"
                                                 IsChecked="{Binding IsModelSlim}"/>
                                </StackPanel>
                                <CheckBox Content="Idle animation" IsChecked="{Binding SkinAnimation}" Margin="0,10,0,0"
                                          Style="{StaticResource AccentCheckBox}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="Quality:" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <ComboBox Width="110" Margin="10,0,0,0"
                                              SelectedValue="{Binding SkinPreviewQuality}" SelectedValuePath="Content"
                                              Style="{StaticResource InputComboBox}">
                                        <ComboBoxItem Content="Low"/>
                                        <ComboBoxItem Content="Medium"/>
                                        <ComboBoxItem Content="High"/>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox Content="Use the slim (Alex) model when uploading" IsChecked="{Binding IsSlimVariant}"
                                          Margin="0,14,0,0" Style="{StaticResource AccentCheckBox}"
                                          ToolTip="Uploaded skins are marked as slim (3px wide arms)"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                                    <Button Content="Change skin..." Style="{StaticResource PrimaryButton}" MinWidth="150"
                                            Command="{Binding ChangeSkinCommand}"
                                            IsEnabled="{Binding IsSkinBusy, Converter={StaticResource InverseBoolean}}"/>
                                    <Button Content="Reset" Style="{StaticResource GhostButton}" MinWidth="110"
                                            Command="{Binding ResetSkinCommand}"
                                            IsEnabled="{Binding IsSkinBusy, Converter={StaticResource InverseBoolean}}"/>
                                </StackPanel>
                                <TextBlock Text="The preview updates instantly when a different skin is selected." Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" MaxWidth="320" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Saved accounts" Style="{StaticResource SectionTitleText}"/>
                <Border Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                            <Setter Property="Padding" Value="24"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="No saved accounts yet. Sign in or add an offline profile above."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                </Border>
                <ListBox ItemsSource="{Binding Accounts}" Style="{StaticResource PlainListBox}" Margin="0,10,0,0"
                         Visibility="{Binding Accounts.Count, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctl:AvatarImage Width="48" Height="48" DisplayName="{Binding Username}"
                                                     ImageUrl="{Binding AvatarUrl}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Username}" Style="{StaticResource SectionTitleText}"/>
                                            <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="4" Margin="8,0,0,0"
                                                    Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource TextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Uuid}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Use" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Remove" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
