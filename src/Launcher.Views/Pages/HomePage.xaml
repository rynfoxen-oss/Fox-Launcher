<UserControl x:Class="Launcher.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.Models;assembly=Launcher.Models"
             xmlns:conv="clr-namespace:Launcher.Views.Converters"
             xmlns:ctl="clr-namespace:Launcher.Views.Controls">
    <UserControl.Resources>
        <conv:RelativeTimeConverter x:Key="RelativeTime"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <TextBlock Text="FoxLauncher" Style="{StaticResource MutedText}"/>
            <TextBlock Text="Your Minecraft launcher" Style="{StaticResource H1Text}" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="28,16,28,28" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Play hero card -->
                <Border Style="{StaticResource CardPanel}" Padding="0">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF20263A" Offset="0"/>
                                <GradientStop Color="#FF151822" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="24" VerticalAlignment="Center">
                            <TextBlock Text="Ready to play" Style="{StaticResource CaptionText}"/>
                            <TextBlock Style="{StaticResource H2Text}" Margin="0,4,0,0">
                                <Run Text="{Binding Instance.Name, FallbackValue='No instance selected', Mode=OneWay}"/>
                                <Run Text="{Binding Instance.LoaderLabel, Mode=OneWay, StringFormat='  ({0})'}" Foreground="{StaticResource TextSecondary}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Instance.DisplayTitle, StringFormat='Version {0}'}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Play" Style="{StaticResource PrimaryButton}" MinWidth="150"
                                        Command="{Binding PlayCommand}"/>
                                <Button Content="Instances" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                        Command="{Binding NavigateInstancesCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                        Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                                <ctl:ProgressRing Width="18" Height="18"/>
                                <TextBlock Text="{Binding InstallStage}" Style="{StaticResource SecondaryText}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Recent instances -->
                <TextBlock Text="Recent instances" Style="{StaticResource SectionTitleText}" Margin="0,22,0,0"/>
                <Grid Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding RecentInstances}"
                                  Visibility="{Binding RecentInstances.Count, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameInstance}">
                                <Border Style="{StaticResource CardPanel}" Width="200" Margin="0,0,12,12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GameVersion}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding LoaderLabel}" Style="{StaticResource CaptionText}"/>
                                        <Button Content="Play" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                                Margin="0,12,0,0"
                                                Command="{Binding DataContext.PlayInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                                <Setter Property="Padding" Value="24"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentInstances.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No instances yet. Create one to start playing." Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- News -->
                <TextBlock Text="Latest news" Style="{StaticResource SectionTitleText}" Margin="0,22,0,0"/>
                <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="9,0,0,9" Background="{StaticResource SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="Headlines" Style="{StaticResource MutedText}" Margin="14,14,14,8"/>
                                <ListBox ItemsSource="{Binding News}" SelectedItem="{Binding SelectedNews, Mode=TwoWay}"
                                         Style="{StaticResource PlainListBox}" MaxHeight="220">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="6,4" FontSize="13"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18">
                            <TextBlock Text="{Binding FeaturedNews.Title}" Style="{StaticResource H2Text}"/>
                            <TextBlock Text="{Binding FeaturedNews.PublishedAt, Converter={StaticResource RelativeTime}}"
                                       Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding FeaturedNews.Body}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                                       MaxHeight="120" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                            <Button Content="Open article" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" Command="{Binding OpenNewsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
