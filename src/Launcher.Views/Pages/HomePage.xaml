<UserControl x:Class="Launcher.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.Models;assembly=Launcher.Models"
             xmlns:conv="clr-namespace:Launcher.Views.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:RelativeTimeConverter x:Key="RelativeTime"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource ContentArea}">
        <StackPanel x:Name="MainContent" Margin="4">

            <!-- ============ Play Hero Section ============ -->
            <Border Style="{StaticResource CardPanel}" Padding="0" Margin="0,0,0,24" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF20263A" Offset="0"/>
                            <GradientStop Color="#FF151822" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Instance info -->
                    <StackPanel Margin="32" VerticalAlignment="Center">
                        <!-- A specific instance is selected -->
                        <StackPanel Visibility="{Binding Instance, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="READY TO PLAY" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Style="{StaticResource H1Text}" FontSize="36" Margin="0,8,0,0"
                                       Text="{Binding Instance.Name, Mode=OneWay}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Background="{DynamicResource AccentDarkBrush}" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="{Binding Instance.LoaderLabel, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="8,4" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Instance.GameVersion, StringFormat='Minecraft {0}'}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Instance.ModsCount, StringFormat=' {0} mods'}" Style="{StaticResource SecondaryText}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FC;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Instance.Overrides.MaxMemoryMb, StringFormat=' {0} MB RAM', FallbackValue=' Auto RAM'}" Style="{StaticResource SecondaryText}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Instance.LastPlayedLabel, StringFormat=' Last played: {0}'}" Style="{StaticResource SecondaryText}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- No specific instance selected -->
                        <StackPanel Visibility="{Binding Instance, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="No Instance Selected" Style="{StaticResource H1Text}" FontSize="36" Margin="0"/>
                            <TextBlock Text="Create or select a Minecraft instance to start playing."
                                       Style="{StaticResource SecondaryText}" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Large Play Button -->
                    <StackPanel Grid.Column="1" Margin="32" VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                        <Button Command="{Binding PlayCommand}" ToolTip="Launch the selected instance"
                                Visibility="{Binding Instance, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                            <Button.Style>
                                <MultiBinding Converter="{x:Static conv:PlayButtonStateConverter.Instance}">
                                    <Binding Path="IsInstalling"/>
                                    <Binding Path="IsLaunching"/>
                                    <Binding Path="LastLaunchError"/>
                                </MultiBinding>
                            </Button.Style>
                        </Button>
                        <Button Content="+  New Instance" Style="{StaticResource PrimaryButton}" Padding="36,16"
                                Margin="0,8,0,0" HorizontalAlignment="Center" MinWidth="220"
                                Command="{Binding CreateInstanceCommand}" ToolTip="Create a new instance (Ctrl+N)"
                                Visibility="{Binding Instance, Converter={StaticResource NullToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Style="{StaticResource AccentProgressBar}" Width="200" Height="6" IsIndeterminate="True"/>
                            <TextBlock Text="{Binding InstallStage}" Style="{StaticResource SecondaryText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Select Instance" Style="{StaticResource GhostButton}" Margin="0,16,0,0"
                                HorizontalAlignment="Center" MinWidth="160"
                                Command="{Binding NavigateInstancesCommand}"
                                Visibility="{Binding Instance, Converter={StaticResource NullToVisibility}}"/>
                        <TextBlock Text="{Binding LastLaunchError}" Style="{StaticResource MutedText}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding LastLaunchError, Converter={StaticResource NullToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Quick Actions ============ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="&#xE710;  New Instance" Style="{StaticResource GhostButton}" Padding="16,10"
                        Command="{Binding CreateInstanceCommand}" ToolTip="Create a new Minecraft instance (Ctrl+N)"/>
                <Button Content="&#xE8B7;  Browse Mods" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="16,10"
                        Command="{Binding NavigateModsCommand}" ToolTip="Browse and install mods from Modrinth"/>
                <Button Content="&#xE790;  Skins" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="16,10"
                        Command="{Binding NavigateSkinsCommand}" ToolTip="Manage skins and accounts"/>
                <Button Content="&#xE713;  Settings" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Padding="16,10"
                        Command="{Binding NavigateSettingsCommand}" ToolTip="Open settings (Ctrl+,)"/>
            </StackPanel>

            <!-- ============ Recent Instances ============ -->
            <TextBlock Text="Recent Instances" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
            <Grid>
                <ItemsControl ItemsSource="{Binding RecentInstances}"
                              Visibility="{Binding RecentInstances.Count, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="280" ItemHeight="200"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameInstance}">
                            <Border Style="{StaticResource InstanceCard}" Margin="8"
                                    MouseLeftButtonUp="OnInstanceCardClick" Tag="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
                                            <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}" FontSize="15"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                            <TextBlock Text="{Binding LoaderLabel}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding GameVersion, StringFormat='Minecraft {0}'}" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ModsCount, StringFormat='{}{0} mods'}" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="&#xE8FC;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Overrides.MaxMemoryMb, StringFormat='RAM: {0} MB', FallbackValue='RAM: Auto'}" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LastPlayedLabel, StringFormat='Last played: {0}'}" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="2" Background="{DynamicResource AccentBrush}" CornerRadius="8" Height="40" Margin="0,16,0,0"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="SELECTED" Foreground="White" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource EmptyStateCard}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding RecentInstances.Count, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="48"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No instances yet" Style="{StaticResource H2Text}" Margin="0,16,0,8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Create your first instance to start playing Minecraft." Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="300"/>
                        <Button Content="+ Create Instance" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                                HorizontalAlignment="Center" Command="{Binding CreateInstanceCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ News Section ============ -->
            <TextBlock Text="Latest News" Style="{StaticResource SectionTitleText}" Margin="0,32,0,12"/>
            <Border Style="{StaticResource CardPanel}" Padding="0" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel>
                            <TextBlock Text="Headlines" Style="{StaticResource MutedText}" Margin="16,16,16,8" FontSize="13"/>
                            <ListBox ItemsSource="{Binding News}" SelectedItem="{Binding SelectedNews, Mode=TwoWay}"
                                     Style="{StaticResource PlainListBox}" MaxHeight="280" Margin="8,0,8,16">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="10,8" FontSize="13" LineHeight="18"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FeaturedNews.Title}" Style="{StaticResource H2Text}" TextWrapping="Wrap" MaxWidth="520"/>
                        <TextBlock Text="{Binding FeaturedNews.PublishedAt, Converter={StaticResource RelativeTime}}"
                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding FeaturedNews.Body}" Style="{StaticResource SecondaryText}" Margin="0,14,0,0"
                                   MaxHeight="160" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                        <Button Content="Read full article" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Margin="0,20,0,0" Command="{Binding OpenNewsCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
