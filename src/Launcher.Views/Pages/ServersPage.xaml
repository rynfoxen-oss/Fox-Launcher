<UserControl x:Class="Launcher.Views.Pages.ServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Views.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Servers" Style="{StaticResource H1Text}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh status" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" Command="{Binding RefreshStatusCommand}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="28,16,28,28" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Add server" Style="{StaticResource H2Text}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Name" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="IP / address" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Port" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Add" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                    Command="{Binding AddCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Style="{StaticResource PlainListBox}"
                         Visibility="{Binding Servers.Count, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SurfaceHoverBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2Text}" FontSize="16"/>
                                            <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}"
                                                       Margin="8,0,0,0" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding Version}" Style="{StaticResource CaptionText}"
                                                       Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0"
                                                       Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                            <Run Text="{Binding Ip, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Motd}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxWidth="460">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Motd}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Join" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Favorite" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Remove" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                            <Setter Property="Padding" Value="24"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="No servers saved yet. Add one above to quick-join your favorite worlds."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
