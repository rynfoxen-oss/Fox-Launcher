<UserControl x:Class="Launcher.Views.Pages.NewsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Views.Converters"
             xmlns:ctl="clr-namespace:Launcher.Views.Controls">
    <UserControl.Resources>
        <conv:RelativeTimeConverter x:Key="RelativeTime"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="News" Style="{StaticResource H1Text}"/>
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="20,0,0,0"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,16,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0" Padding="0">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Style="{StaticResource PlainListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,8">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" FontSize="14"/>
                                <TextBlock Text="{Binding PublishedAt, Converter={StaticResource RelativeTime}}"
                                           Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource SurfaceAltBrush}" Margin="0,0,0,14">
                        <Image Source="{Binding Selected.ImageUrl}" Stretch="UniformToFill" MaxHeight="260"/>
                    </Border>
                    <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="{Binding Selected.PublishedAt, Converter={StaticResource RelativeTime}}"
                               Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Selected.Body}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                    <Button Content="Open in browser" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Margin="0,16,0,0" Command="{Binding OpenCommand}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ctl:ProgressRing Width="28" Height="28"/>
                <TextBlock Text="Loading news..." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
