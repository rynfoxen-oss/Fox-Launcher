<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FF0F1218"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#FF141822"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF171B24"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF1E2430"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF232B3A"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF1B202C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF2A3242"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF39445A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFE9ECF3"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA3B2"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF677184"/>

    <!-- Accent (overridden at runtime by settings) -->
    <Color x:Key="AccentColor">#FF8B3D</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8B3D"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FFB47747"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF5E2B16"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#66FF8B3D"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE0554E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF57C785"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE0B64E"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#FF4E9BE0"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#FFFF8B3D"/>

    <!-- Background images used by the home page slideshow -->
    <SolidColorBrush x:Key="BackgroundOverlayBrush" Color="#B312161F"/>

    <!-- Geometry/rounded corner radius -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">8</CornerRadius>
    <CornerRadius x:Key="InputRadius">8</CornerRadius>

    <!-- Drop shadow for cards -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.35"/>

    <!-- Blur brush used on floating panels -->
    <BlurEffect x:Key="PanelBlur" Radius="24" RenderingBias="Performance"/>

</ResourceDictionary>
