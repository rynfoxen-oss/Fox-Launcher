<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Midnight theme overrides (darker, blue-purple tint) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FF0A0B10"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#FF101219"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF12151E"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF181C29"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF1F2435"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF151926"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF262C3E"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF35405C"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFE7EAF2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA2B8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF626C86"/>

    <SolidColorBrush x:Key="BackgroundOverlayBrush" Color="#CC0A0B10"/>

</ResourceDictionary>
