<UserControl x:Class="Launcher.Views.Controls.AvatarImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Ellipse x:Name="Backdrop" Fill="{StaticResource SurfaceBrush}" Stroke="{StaticResource BorderBrush}"/>
        <Image x:Name="Photo" Visibility="Collapsed" Stretch="UniformToFill"/>
        <TextBlock x:Name="Initials" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource H2Text}" Foreground="{StaticResource AccentBrush}"/>
    </Grid>
</UserControl>
