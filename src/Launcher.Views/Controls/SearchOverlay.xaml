<UserControl x:Class="Launcher.Views.Controls.SearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Views.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="#CC0B0E14"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"
          Focusable="True"
          PreviewKeyDown="OnPreviewKeyDown" MouseLeftButtonDown="OnBackdropClick">

        <Border Width="640" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="14" Padding="0"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                Effect="{DynamicResource CardShadow}"
                MouseLeftButtonDown="OnPanelClicked">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,16,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SearchIcon" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource GlobalSearchBox}" AutomationProperties.Name="Global search"/>
                </Grid>

                <ListBox x:Name="ResultsList" Grid.Row="2" Margin="8,0,8,8"
                         ItemsSource="{Binding Results}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         Style="{StaticResource PlainListBox}" VerticalAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="OnResultDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource AccentDarkBrush}" CornerRadius="4"
                                        Padding="8,2" Margin="8,0,2,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Background="{DynamicResource TitleBarBackground}" CornerRadius="0,0,14,14"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                    <TextBlock Text="&#xE8FD;  ↑↓ navigate   ·   Enter open   ·   Esc close"
                               Style="{StaticResource CaptionText}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>